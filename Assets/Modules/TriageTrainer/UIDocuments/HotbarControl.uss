.hotbar {
  flex-direction: row;
  justify-content: center;
  align-items: flex-end;
  padding: 8px 12px;
  column-gap: 8px;
  width: 100%;
  -unity-font-definition: var(--unity-default-font);
}

.hotbar__slot {
  margin: 5px;
  width: 56px;
  height: 56px;
  border: 2px solid #515151;
  background-color: rgba(20, 20, 20, 0.65);
  border-radius: 6px;
  align-items: center;
  justify-content: center;
  position: relative;
}

.hotbar__slot--selected {
  border-color: #f5d37d;
  border-width: 3px;
  box-shadow: 0 0 8px rgba(245, 211, 125, 0.75);
}

.hotbar__slot-icon {
  width: 42px;
  height: 42px;
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
  position: absolute;
  z-index: 1;
}

.hotbar__slot-count {
  position: absolute;
  right: 4px;
  bottom: 2px;
  font-size: 14px;
  color: #f5f5f5;
  -unity-font-definition: var(--unity-default-font);
  font-weight: bold;
  -unity-font-style: bold;
  -unity-text-outline-color: rgba(0, 0, 0, 0.9);
  -unity-text-outline-width: 1px;
  z-index: 30;
  padding: 0 2px;
}

.hotbar__slot-empty {
  opacity: 0.35;
}

.hotbar__slot-label {
  position: absolute;
  top: 2px;
  left: 4px;
  font-size: 10px;
  color: rgba(255,255,255,0.65);
  z-index: 20;
  -unity-font-definition: var(--unity-default-font);
}
