:root {
  --bg: rgba(0, 0, 0, .5);
  --font-size: 12px;
  --scroller-width: 5px;
}

.chat-toast-container {
  position: absolute;
  left: 18px;
  bottom: 18px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  max-width: 360px;
  pointer-events: none;
  z-index: 200;
}

.chat-toast {
  background-color: rgba(0, 0, 0, 0.72);
  color: #fdfdf2;
  padding: 6px 8px;
  font-size: var(--font-size);
  line-height: 1.3;
  border-left: 2px solid #4fc3f7;
  opacity: 0;
  transition: opacity 0.15s ease-in-out;
  z-index: 200;
}

.chat-toast__label {
  white-space: pre-wrap;
  word-break: break-word;
}

.chat-root {
  display: flex;
  position: absolute;
  left: 18px;
  bottom: 18px;
  width: 360px;
  padding: 10px;
  flex-direction: column;
  gap: 6px;
  transition: opacity 0.1s ease-in-out;
}

.chat-root.collapsed {
  opacity: 0;
  pointer-events: none;
  /* Backup visibility hide */
  visibility: hidden; 
}

.chat-root.expanded {
  opacity: 1;
  pointer-events: auto;
  visibility: visible;
}

.chat-layout {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.unity-scroll-view__viewport {
  padding-right: 6px;
}

.chat-log {
  background-color: var(--bg);
  padding: 6px;
  height: 170px;
  min-height: 32px;
  margin-bottom: 4px;
  flex-shrink: 0;
  align-items: stretch;
}

.chat-log .unity-scroll-view__content-container {
  flex-direction: column;
  justify-content: flex-start;
  gap: 4px;
  width: 100%;
}

.chat-log .unity-scroller > .unity-scroller__low-button,
.chat-log .unity-scroller > .unity-scroller__high-button {
  width: 0;
  height: 0;
  min-width: 0;
  min-height: 0;
  display: none;
}

.chat-log .unity-scroller--vertical {
  width: var(--scroller-width);
  min-width: 0;
  margin: 0;
}
.chat-log .unity-scroller--vertical > .unity-scroller__slider
{
  width: var(--scroller-width);
  min-width: 0;
  margin: 0;
}

.chat-log .unity-base-slider--vertical .unity-base-slider__dragger {
  left: 0;
  width: var(--scroller-width);
  margin-right: 0;
  margin-left: 0;
}

.chat-log .unity-base-slider__tracker
{
  background-color: rgba(255, 255, 255, 0.2);
  border-color: transparent;
}

.chat-log .unity-base-slider .unity-base-slider__dragger
{
  border-width: 0;
  border-color: transparent;
}

.chat-log .unity-scroller--vertical .unity-base-slider__dragger
{
  background-color: rgba(255, 255, 255, 0.5);
  left: 0;
  width: var(--scroller-width);
}

.chat-log__entry {
  white-space: pre-wrap;
  word-break: break-word;
  color: #fdfdf2;
  font-size: var(--font-size);
  line-height: 1.3;
}

.chat-log__label {
  white-space: pre-wrap;
  color: #fdfdf2;
  font-size: var(--font-size);
  line-height: 1.3;
}

.chat-input-row {
  flex-direction: column;
}

.chat-input-bg {
  background-color: var(--bg);
  padding: 8px 10px;
}

.chat-input {
  width: 100%;
  color: #ffffff;
  background-color: transparent;
  border: none;
  font-size: var(--font-size);
}

.chat-input .unity-base-text-field__input {
  background-color: transparent;
  border: 0;
  border-color: transparent;
  color: #ffffff;
  padding: 0;
}
