<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Style src="NetworkSessionFailureScene.uss" />
  <ui:VisualElement name="failure-screen" class="failure-screen is-hidden">
    <ui:VisualElement class="failure-card">
      <ui:Label name="failure-title" class="failure-title" text="서버 연결이 종료되었습니다" />
      <ui:Label name="failure-detail" class="failure-detail" text="" />
      <ui:Label name="failure-log-path" class="failure-log-path" text="" />
      <ui:Button name="failure-title-button" class="failure-title-button" text="타이틀로 돌아가기" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
