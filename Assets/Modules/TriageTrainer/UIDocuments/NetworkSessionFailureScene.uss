:root {
  --failure-background: rgba(8, 12, 22, 0.98);
  --failure-card: rgba(22, 29, 46, 0.99);
  --failure-title: rgba(255, 255, 255, 0.98);
  --failure-detail: rgba(242, 246, 255, 0.96);
  --failure-muted: rgba(190, 202, 226, 0.88);
}

.failure-screen {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: auto;
  height: auto;
  flex-grow: 1;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  background-color: var(--failure-background);
}

.failure-screen.is-hidden {
  display: none;
}

.failure-card {
  width: 80%;
  max-width: 960px;
  min-height: 30%;
  padding-left: 40px;
  padding-right: 40px;
  padding-top: 40px;
  padding-bottom: 40px;
  align-items: center;
  justify-content: center;
  background-color: var(--failure-card);
  border-radius: 12px;
}

.failure-title,
.failure-detail,
.failure-log-path {
  -unity-text-align: middle-center;
  white-space: normal;
}

.failure-title {
  color: var(--failure-title);
  font-size: 28px;
  -unity-font-style: bold;
  margin-bottom: 20px;
}

.failure-detail {
  color: var(--failure-detail);
  font-size: 20px;
  margin-bottom: 20px;
}

.failure-log-path {
  color: var(--failure-muted);
  font-size: 16px;
  margin-bottom: 28px;
}

.failure-title-button {
  min-width: 240px;
  min-height: 52px;
  padding-left: 24px;
  padding-right: 24px;
  padding-top: 12px;
  padding-bottom: 12px;
  color: var(--failure-title);
  font-size: 18px;
  -unity-font-style: bold;
}
