:root {
  --failure-background: rgba(8, 12, 22, 0.98);
  --failure-card: rgba(22, 29, 46, 0.99);
  --failure-title: rgba(255, 255, 255, 0.98);
  --failure-detail: rgba(242, 246, 255, 0.96);
  --failure-muted: rgba(190, 202, 226, 0.88);
}

.failure-screen {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  background-color: var(--failure-background);
}

.failure-screen.is-hidden {
  display: none;
}

.failure-card {
  width: 70%;
  min-height: 35%;
  padding-left: 64px;
  padding-right: 64px;
  padding-top: 56px;
  padding-bottom: 56px;
  align-items: center;
  justify-content: center;
  background-color: var(--failure-card);
  border-radius: 12px;
}

.failure-title,
.failure-detail,
.failure-log-path {
  -unity-text-align: middle-center;
  white-space: normal;
}

.failure-title {
  color: var(--failure-title);
  font-size: 42px;
  -unity-font-style: bold;
  margin-bottom: 28px;
}

.failure-detail {
  color: var(--failure-detail);
  font-size: 26px;
  margin-bottom: 28px;
}

.failure-log-path {
  color: var(--failure-muted);
  font-size: 18px;
}
