.inventory-root {
  width: 100%;
  height: 100%;
  justify-content: center;
  align-items: center;
}

.inventory-grid {
  display: flex;
  flex-wrap: wrap;
  width: 540px;
  gap: 4px;
}

.inventory-slot {
  width: 58px;
  height: 58px;
  background-color: #161616;
  border: 2px solid #555;
  position: relative;
}

.inventory-slot.hover {
  border-color: #fff;
}

.inventory-slot.occupied {
  border-color: #8fc954;
}

.slot-icon {
  width: 100%;
  height: 100%;
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
}

.slot-count {
  position: absolute;
  bottom: 2px;
  right: 4px;
  font-size: 14px;
  color: #fff;
  -unity-font-style: bold;
}

.held-item-container {
  position: absolute;
  pointer-events: none;
}

.held-item-icon {
  width: 64px;
  height: 64px;
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
}

.held-item-count {
  position: absolute;
  bottom: 0;
  right: 0;
  font-size: 16px;
  color: #fff;
  -unity-font-style: bold;
}
