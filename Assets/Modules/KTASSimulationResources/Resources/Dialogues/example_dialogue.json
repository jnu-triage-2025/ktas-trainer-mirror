{
  "dialogueId": "npc_doctor_intro",
  "metadata": {
    "author": "Developer",
    "version": "1.0.0",
    "description": "의사 NPC 소개 대화"
  },
  "dialogues": [
    {
      "identifier": "intro_1",
      "speakerName": "의사",
      "dialogueText": "안녕하세요. 저는 이 병원의 응급의학과 전문의입니다.",
      "nextDialogueIdentifier": "intro_2",
      "customTypingSpeed": 0.03
    },
    {
      "identifier": "intro_2",
      "speakerName": "의사",
      "dialogueText": "오늘 「트리아지」 훈련을 담당하게 되었습니다. 무엇을 도와드릴까요?",
      "nextDialogueIdentifier": "",
      "customTypingSpeed": 0.03,
      "selections": [
        {
          "identifier": "sel_explain",
          "displayText": "트리아지가 무엇인가요?",
          "nextDialogueIdentifier": "explain_triage"
        },
        {
          "identifier": "sel_start",
          "displayText": "훈련을 시작하고 싶습니다.",
          "nextDialogueIdentifier": "start_training"
        },
        {
          "identifier": "sel_bye",
          "displayText": "나중에 다시 오겠습니다.",
          "nextDialogueIdentifier": ""
        }
      ]
    },
    {
      "identifier": "explain_triage",
      "speakerName": "의사",
      "dialogueText": "트리아지는 대량 환자 발생 시 치료 우선순위를 결정하는 체계입니다.",
      "nextDialogueIdentifier": "explain_triage_2",
      "customTypingSpeed": 0.03
    },
    {
      "identifier": "explain_triage_2",
      "speakerName": "의사",
      "dialogueText": "환자의 상태를 빠르게 평가하여 「즉시」, 「지연」, 「경증」, 「사망」으로 분류합니다.",
      "nextDialogueIdentifier": "intro_2",
      "customTypingSpeed": 0.03
    },
    {
      "identifier": "start_training",
      "speakerName": "의사",
      "dialogueText": "좋습니다. 훈련장으로 안내해 드리겠습니다. 저를 따라오세요.",
      "nextDialogueIdentifier": "",
      "customTypingSpeed": 0.03
    }
  ]
}
