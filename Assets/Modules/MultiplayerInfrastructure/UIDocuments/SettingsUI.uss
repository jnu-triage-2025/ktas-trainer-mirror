/* ============================================================
   통합 설정 UI — SettingsUI.uss
   키 설정 / 그래픽 설정을 탭으로 통합한 설정 창.
   기존 KeyConfigUI.uss / GraphicsSettingsUI.uss 의 규칙을 계승/통합한다.
   ============================================================ */

/* ── 전체 화면 컨테이너 ─────────────────────────────────────── */
/* 설정은 별도 창이 아니라 화면 전체를 여백 없이 채우는 전체 화면 페이지로 표시한다. */
.settings__root {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
}

/* 컨트롤러가 Show() 호출 전에는 보이지 않도록 초기 상태를 숨김으로 둔다. */
.settings__root {
  opacity: 0;
}

/* ── 전체 화면 패널 ───────────────────────────────────────── */
/* 화면 전체를 여백 없이 채운다(창 형태의 라운드/테두리/딤 배경 없음). */
.settings__panel {
  flex-grow: 1;
  width: 100%;
  height: 100%;
  background-color: #1c1c22;
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

/* ── 헤더 ──────────────────────────────────────────────────── */
.settings__header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}

.settings__title {
  font-size: 14px;
  color: #f0f0f5;
  -unity-font-style: bold;
}

.settings__close-btn {
  width: 28px;
  height: 28px;
  font-size: 14px;
  color: #aaaabc;
  background-color: #2a2a34;
  border-radius: 6px;
  border-width: 1px;
  border-color: #44444e;
  padding: 0;
}

.settings__close-btn:hover {
  background-color: #3a3a46;
  color: #f0f0f5;
}

.settings__close-btn:active {
  background-color: #c0392b;
  color: #ffffff;
  border-color: #c0392b;
}

/* ── 탭 바 ─────────────────────────────────────────────────── */
.settings__tab-bar {
  display: flex;
  flex-direction: row;
  gap: 4px;
  flex-wrap: wrap;
  flex-shrink: 0;
}

.settings__tab-button {
  height: 34px;
  min-width: 96px;
  font-size: 13px;
  color: #aaaabc;
  background-color: #25252e;
  border-radius: 6px 6px 0 0;
  border-width: 1px;
  border-color: #3a3a46;
  padding: 0 18px;
}

.settings__tab-button:hover {
  background-color: #2e2e3a;
  color: #f0f0f5;
}

.settings__tab-button--active {
  background-color: #1e2a4a;
  color: #5a9fff;
  border-color: #2d7cf4;
  -unity-font-style: bold;
}

/* ── 구분선 ────────────────────────────────────────────────── */
.settings__divider {
  height: 1px;
  background-color: #2e2e3a;
  flex-shrink: 0;
}

/* ── 탭 컨텐츠 영역 ─────────────────────────────────────────── */
/* 남는 공간을 모두 차지하되, 내부 컨텐츠가 넘쳐도 패널을 밀어내지 않도록 min-height:0 */
.settings__tab-content {
  flex-grow: 1;
  flex-shrink: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
  overflow: hidden;
}

/* 탭 컨텐츠의 최상위 래퍼(코드에서 생성)는 남는 높이를 채운다. */
.settings__tab-content > VisualElement {
  flex-grow: 1;
  min-height: 0;
}

/* ── 푸터 ──────────────────────────────────────────────────── */
.settings__footer {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  min-height: 16px;
}

.settings__status {
  font-size: 11px;
  color: #5e7c5e;
  flex-grow: 1;
  /* 라벨은 클릭 대상이 아니므로 포인터 이벤트를 통과시킨다(슬라이더 등 하위 클릭 보호). */
  /* 실제 pickingMode 는 컨트롤러가 표시 시 Ignore 로 재설정한다. */
}

/* ============================================================
   공통 섹션 스타일 (탭 컨텐츠 내부)
   ============================================================ */
.settings__section {
  display: flex;
  flex-direction: column;
  gap: 10px;
  flex-shrink: 0;
}

.settings__section-title {
  font-size: 12px;
  color: #7878a0;
  -unity-font-style: bold;
  -unity-text-align: upper-left;
  padding-left: 4px;
  padding-bottom: 6px;
  margin-bottom: 4px;
  border-bottom-width: 1px;
  border-color: #2e2e3a;
}

.settings__section--spaced {
  margin-top: 16px;
}

.settings__section-desc {
  font-size: 11px;
  color: #5e5e78;
  -unity-text-align: upper-left;
  white-space: normal;
}

/* 탭 컨텐츠 래퍼(코드 생성) */
.settings__key-tab-wrapper {
  flex-direction: column;
  flex-grow: 1;
  min-height: 0;
}

.settings__graphics-tab-wrapper {
  flex-direction: column;
  flex-grow: 1;
  min-height: 0;
}

.settings__general-tab-wrapper {
  flex-grow: 1;
  min-height: 0;
}

/* ── 액션(초기화 등) 버튼 행 ────────────────────────────────── */
.settings__actions {
  display: flex;
  flex-direction: row;
  gap: 8px;
  justify-content: flex-end;
  flex-shrink: 0;
  margin-top: 8px;
  flex-wrap: wrap;
}

.settings__actions--start {
  justify-content: flex-start;
}

.settings__primary-btn {
  height: 34px;
  min-width: 120px;
  font-size: 13px;
  color: #f4f4f7;
  background-color: #2d7cf4;
  border-radius: 6px;
  border-width: 1px;
  border-color: #2d7cf4;
  padding: 0 16px;
}

.settings__primary-btn:hover {
  background-color: #3a89ff;
}

.settings__primary-btn:active {
  background-color: #236bce;
}

.settings__secondary-btn {
  height: 34px;
  min-width: 100px;
  font-size: 13px;
  color: #d0d0e8;
  background-color: #2f2f36;
  border-radius: 6px;
  border-width: 1px;
  border-color: #44444d;
  padding: 0 16px;
}

.settings__secondary-btn:hover {
  background-color: #3a3a43;
}

.settings__secondary-btn:active {
  background-color: #2a2a32;
}

.settings__danger-btn {
  height: 34px;
  min-width: 120px;
  font-size: 13px;
  color: #fff3f3;
  background-color: #8f3030;
  border-radius: 6px;
  border-width: 1px;
  border-color: #b64848;
  padding: 0 16px;
}

.settings__danger-btn:hover { background-color: #aa3939; }
.settings__danger-btn:active { background-color: #742626; }

/* ============================================================
   키 설정 탭
   ============================================================ */
/* 좌: 목록 / 우: 키보드. 남는 높이를 채우되 내부 스크롤로 처리(min-height:0). */
.settings__key-content {
  display: flex;
  flex-direction: row;
  gap: 20px;
  flex-grow: 1;
  flex-shrink: 1;
  min-height: 0;
}

.settings__key-list-panel {
  width: 240px;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-height: 0;
}

.settings__panel-title {
  font-size: 12px;
  color: #7878a0;
  -unity-font-style: bold;
  padding-left: 4px;
  padding-bottom: 6px;
  border-bottom-width: 1px;
  border-color: #2e2e3a;
}

.settings__key-scroll {
  flex-grow: 1;
  min-height: 0;
  background-color: #17171e;
  border-radius: 6px;
  border-width: 1px;
  border-color: #2e2e3a;
}

.settings__key-scroll #unity-content-container {
  padding: 4px;
}

.settings__key-keyboard-panel {
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  gap: 8px;
}

/* 키보드 요소 — 키가 퍼센트 좌표로 배치되므로 명시적 크기가 반드시 필요하다.
   (이 규칙이 없으면 컨테이너가 0 크기로 접혀 키보드가 보이지 않는다.) */
.settings__key-keyboard {
  width: 100%;
  height: 240px;
  flex-shrink: 0;
}

/* ============================================================
   KeyboardLayoutElement 내부 스타일 (KeyConfigUI.uss 에서 이식)
   ============================================================ */
.keyboard-layout {
  width: 100%;
  height: 100%;
  overflow: visible;
  border-radius: 8px;
  background-color: #c8c8c8;
  padding: 2px;
}

.keyboard-layout__bg {
  display: none;
}

.keyboard-layout__overlay-container {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.keyboard-layout__key {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: flex-start;
  padding: 0 1px;
  border-radius: 4px;
  background-color: #f5f5f5;
  border-width: 1px;
  border-color: #9e9e9e;
}

.keyboard-layout__key:hover {
  background-color: #e0e0e0;
  border-color: #777777;
}

.keyboard-layout__key:active {
  background-color: #c8c8c8;
  border-color: #555555;
}

.keyboard-layout__key-name {
  font-size: 6px;
  color: rgba(30, 30, 30, 0.75);
  -unity-text-align: upper-right;
  overflow: hidden;
  white-space: nowrap;
  margin: 0;
  padding: 0;
}

.keyboard-layout__key-action {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 8px;
  font-size: 6px;
  -unity-font-style: bold;
  color: #1a4a99;
  -unity-text-align: middle-center;
  overflow: hidden;
  white-space: nowrap;
}

.keyboard-layout__key--assigned {
  background-color: #dbeafe;
  border-radius: 4px;
  border-width: 1px;
  border-color: #3b82f6;
}

.keyboard-layout__key--assigned:hover {
  background-color: #bfdbfe;
  border-color: #2563eb;
}

.keyboard-layout__key--assigned:active {
  background-color: #93c5fd;
  border-color: #1d4ed8;
}

.keyboard-layout__key--highlighted {
  background-color: #fef9c3;
  border-width: 2px;
  border-color: #eab308;
  border-radius: 4px;
}

.keyboard-layout__key--highlighted .keyboard-layout__key-action {
  color: #7a4800;
}

/* ============================================================
   KeyConfigEntryElement 스타일 (KeyConfigUI.uss 에서 이식)
   ============================================================ */
.key-config-entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 4px 6px;
  border-radius: 5px;
  margin-bottom: 1px;
}

.key-config-entry:hover {
  background-color: rgba(255, 255, 255, 0.06);
}

.key-config-entry:active {
  background-color: rgba(255, 255, 255, 0.10);
}

.key-config-entry__action {
  font-size: 11px;
  color: #d4d4e8;
  flex-grow: 1;
  white-space: nowrap;
  overflow: hidden;
}

.key-config-entry__key {
  font-size: 10px;
  color: #a0a0c8;
  background-color: #2a2a38;
  border-radius: 4px;
  border-width: 1px;
  border-color: #44445a;
  padding: 1px 5px;
  -unity-font-style: bold;
  min-width: 36px;
  -unity-text-align: middle-center;
  white-space: nowrap;
}

.key-config-entry--focused {
  background-color: rgba(240, 200, 50, 0.15);
  border-width: 1px;
  border-color: rgba(240, 200, 50, 0.5);
  border-radius: 5px;
}

.key-config-entry--focused .key-config-entry__action {
  color: #fff176;
}

.key-config-entry--focused .key-config-entry__key {
  border-color: rgba(240, 200, 50, 0.7);
  color: #fff176;
  background-color: rgba(240, 200, 50, 0.18);
}

.key-config-entry--selected {
  background-color: rgba(45, 124, 244, 0.20);
  border-width: 1px;
  border-color: rgba(45, 124, 244, 0.55);
  border-radius: 5px;
}

.key-config-entry--selected .key-config-entry__action {
  color: #a8c8ff;
}

.key-config-entry--selected .key-config-entry__key {
  border-color: rgba(45, 124, 244, 0.7);
  color: #a8c8ff;
  background-color: rgba(45, 124, 244, 0.22);
}

/* ============================================================
   그래픽 설정 탭
   ============================================================ */
.settings__graphics-options {
  display: flex;
  flex-direction: row;
  gap: 10px;
  flex-wrap: wrap;
}

.settings__graphics-field-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 30px;
  gap: 12px;
  padding: 2px 4px;
}

.settings__graphics-field-row:hover {
  background-color: rgba(255, 255, 255, 0.025);
}

.settings__graphics-field-label {
  width: 220px;
  flex-shrink: 0;
  font-size: 11px;
  color: #b8b8ca;
}

.settings__graphics-field-control {
  flex-grow: 1;
  min-width: 180px;
}

/* 텍스처 품질 옵션 타일 (TextureQualityOptionElement) */
.texture-quality-option {
  flex: 1;
  min-width: 100px;
  padding: 14px 10px;
  background-color: #25252e;
  border-radius: 8px;
  border-width: 2px;
  border-color: #3a3a46;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  transition-duration: 0.12s;
  transition-property: background-color, border-color;
}

.texture-quality-option:hover {
  background-color: #2e2e3a;
  border-color: #5050a0;
}

.texture-quality-option--active {
  background-color: #1e2a4a;
  border-color: #2d7cf4;
}

.texture-quality-option--active:hover {
  background-color: #1e2a4a;
  border-color: #3a89ff;
}

.texture-quality-option__label {
  font-size: 13px;
  color: #d0d0e8;
  -unity-font-style: bold;
  -unity-text-align: middle-center;
}

.texture-quality-option--active .texture-quality-option__label {
  color: #5a9fff;
}

.texture-quality-option__subtitle {
  font-size: 10px;
  color: #5e5e78;
  -unity-text-align: middle-center;
}

.texture-quality-option--active .texture-quality-option__subtitle {
  color: #4070c0;
}

/* UI 배율 옵션 타일 (UIScaleOptionElement) */
.ui-scale-option {
  flex: 1;
  min-width: 100px;
  padding: 14px 10px;
  background-color: #25252e;
  border-radius: 8px;
  border-width: 2px;
  border-color: #3a3a46;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  transition-duration: 0.12s;
  transition-property: background-color, border-color;
}

.ui-scale-option:hover {
  background-color: #2e2e3a;
  border-color: #5050a0;
}

.ui-scale-option--active {
  background-color: #1e2a4a;
  border-color: #2d7cf4;
}

.ui-scale-option--active:hover {
  background-color: #1e2a4a;
  border-color: #3a89ff;
}

.ui-scale-option__label {
  font-size: 13px;
  color: #d0d0e8;
  -unity-font-style: bold;
  -unity-text-align: middle-center;
}

.ui-scale-option--active .ui-scale-option__label {
  color: #5a9fff;
}

.ui-scale-option__subtitle {
  font-size: 10px;
  color: #5e5e78;
  -unity-text-align: middle-center;
}

.ui-scale-option--active .ui-scale-option__subtitle {
  color: #4070c0;
}

/* ── POV(카메라 거리) 슬라이더 ─────────────────────────────── */
.settings__pov-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12px;
}

.settings__pov-slider {
  flex-grow: 1;
}

.settings__pov-value {
  width: 64px;
  font-size: 12px;
  color: #d0d0e8;
  -unity-text-align: middle-right;
}

/* 좁거나 낮은 해상도에서는 고정 폭/높이 요소를 세로 흐름과 내부 스크롤로 전환한다. */
.settings__root--compact .settings__panel {
  padding: 8px;
  gap: 7px;
}

.settings__root--compact .settings__tab-button {
  min-width: 76px;
  padding: 0 10px;
}

.settings__root--compact .settings__key-content {
  flex-direction: column;
  gap: 10px;
  overflow: hidden;
}

.settings__root--compact .settings__key-list-panel {
  width: auto;
  flex-grow: 1;
  flex-shrink: 1;
  min-height: 120px;
}

.settings__root--compact .settings__key-keyboard-panel {
  flex-grow: 0;
  flex-shrink: 0;
}

.settings__root--compact .settings__key-keyboard {
  height: 170px;
}

.settings__root--compact .settings__graphics-options {
  gap: 6px;
}

.settings__root--compact .settings__graphics-field-row {
  flex-direction: column;
  align-items: stretch;
  gap: 3px;
}

.settings__root--compact .settings__graphics-field-label {
  width: auto;
}

.settings__root--compact .texture-quality-option,
.settings__root--compact .ui-scale-option {
  min-width: 76px;
  padding: 9px 6px;
}
