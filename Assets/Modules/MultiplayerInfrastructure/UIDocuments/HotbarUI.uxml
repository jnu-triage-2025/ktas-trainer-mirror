<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
  xmlns:ui="UnityEngine.UIElements"
  xmlns:mi="MultiplayerInfrastructure.UI"
>
  <ui:Style src="HotbarUI.uss" />
  <ui:VisualElement class="hotbar-container" style="flex-direction: column; justify-content: flex-end; align-items: center; position: relative; width: 100%; height: 100%;">
    <ui:Label name="hotbar-item-name" class="hotbar__item-name hotbar__item-name--hidden" />
    <mi:HotbarControl name="hotbar-root" class="hotbar" slot-count="9" />
  </ui:VisualElement>
</ui:UXML>
