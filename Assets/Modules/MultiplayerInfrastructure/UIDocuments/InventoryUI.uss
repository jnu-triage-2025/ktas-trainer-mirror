.inventory-ui-wrapper {
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
}

.inventory-root {
  width: 420px;
  padding: 12px;
  background-color: #c6c6c6;
  border: 2px solid #000;
  gap: 8px;
}

/*
.inventory-root--visible {
  visibility: visible;
}
.inventory-root--hidden {
  visibility: hidden;
}
*/

.inventory-title {
  -unity-font-style: bold;
  font-size: 18px;
  color: #222;
  margin-bottom: 4px;
}

.inventory-grid {
  border: 2px solid #555;
  padding: 8px;
  gap: 6px;
  flex-wrap: wrap;
  flex-direction: column;
  background-color: #bdbdbd;
  min-height: 120px;
}

.slot-row {
  flex-direction: row;
}

.slot {
  width: 54px;
  height: 54px;
  border: 2px solid #777;
  background-color: #d9d9d9;
  justify-content: flex-end;
  align-items: flex-end;
  padding: 2px;
  position: relative;
}

.slot__icon {
  position: absolute;
  left: 4px;
  right: 4px;
  top: 4px;
  bottom: 4px;
  tint-color: white;
}

.slot__count {
  background-color: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 11px;
  padding: 1px 3px;
  border-radius: 2px;
  -unity-text-align: middle-right;
}

.held-item-ghost {
  position: absolute;
  width: 48px;
  height: 48px;
  pointer-events: none;
}

.held-item-ghost__icon {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  tint-color: white;
}

.held-item-ghost__count {
  position: absolute;
  right: 2px;
  bottom: 2px;
  background-color: rgba(0, 0, 0, 0.65);
  color: #fff;
  font-size: 11px;
  padding: 1px 3px;
  border-radius: 2px;
  -unity-text-align: middle-right;
}

/* ── 아이템 툴팁 ─────────────────────────────────────────────── */
.item-tooltip {
  position: absolute;
  max-width: 260px;
  min-width: 120px;
  padding: 8px 10px;
  background-color: rgba(18, 18, 22, 0.95);
  border-width: 1px;
  border-color: #3a3a46;
  border-radius: 6px;
  gap: 3px;
}

.item-tooltip__name {
  -unity-font-style: bold;
  font-size: 14px;
  color: #fff;
  white-space: normal;
}

.item-tooltip__type {
  font-size: 10px;
  color: #9a9aa5;
  -unity-font-style: italic;
}

.item-tooltip__description {
  font-size: 12px;
  color: #d5d5db;
  white-space: normal;
  margin-top: 2px;
}

.item-tooltip__detail {
  font-size: 11px;
  color: #a7a7b2;
  white-space: normal;
}

.item-tooltip__stack {
  font-size: 11px;
  color: #c9c9d2;
  margin-top: 2px;
  -unity-text-align: middle-left;
}
