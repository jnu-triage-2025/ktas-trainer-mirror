.inventory-ui-wrapper {
  width: 100%;
  height: 100%;
}

/* ── 가로 스크롤 래퍼 ────────────────────────────────────────────
 * 해상도가 부족할 때 인벤토리+조합 패널이 뷰포트를 넘치면 가로 스크롤바를 표시한다.
 * 세로 스크롤은 사용하지 않는다. */
.inventory-scroll-view {
  width: 100%;
  height: 100%;
  flex-grow: 1;
  background-color: transparent;
  overflow: hidden;
}

.inventory-scroll-view .unity-scroll-view__viewport {
  overflow: hidden;
}

/* ScrollView 콘텐츠 컨테이너: 가로·세로 중앙 정렬 (C#에서 클래스 추가).
 * 인벤토리 창(루트)을 뷰포트 중앙에 배치한다.
 * 세로 넘침 시 상단이 잘릴 수 있으나, 현재 인벤토리 높이는 대부분의 해상도에 맞는다. */
.inventory-scroll-content {
  align-items: center;
  justify-content: center;
  min-height: 100%;
}

/*
 * 인벤토리 루트: 좌측 인벤토리 그리드 + 우측 조합 패널을 나란히 배치.
 * 스타일 팔레트는 ItemSubmissionUI 와 통일(navy 계열).
 */
.inventory-root {
  flex-direction: row;
  flex-shrink: 0;
  padding: 20px;
  background-color: #16213e;
  border-width: 2px;
  border-color: #2d4373;
  border-radius: 14px;
  gap: 16px;
}

/* ── 좌측 인벤토리 영역 ───────────────────────────────────────
 * 너비를 고정하지 않는다: 그리드(9칸×54px + gap/padding ≈ 556px)가
 * 고정 폭보다 넓으면 슬롯이 패널 밖으로 넘쳐 우측 조합 패널에 가려지고,
 * 그 결과 넘친 슬롯이 포인터 이벤트(클릭/hover)를 받지 못한다.
 * 내용 크기에 맞춰 auto 로 둔다. */
.inventory-panel {
  flex-shrink: 0;
}

.inventory-title {
  -unity-font-style: bold;
  font-size: 18px;
  color: #f0f4ff;
  letter-spacing: 1px;
  margin-bottom: 10px;
}

.inventory-grid {
  border-width: 1px;
  border-color: #1f3a63;
  border-radius: 10px;
  padding: 10px;
  gap: 6px;
  flex-wrap: wrap;
  flex-direction: column;
  /* 소유 아이템(슬롯) 부분의 세로 정렬: top → middle(center) */
  justify-content: center;
  background-color: rgba(6, 16, 32, 0.75);
  min-height: 120px;
}

.slot-row {
  flex-direction: row;
}

.slot {
  width: 54px;
  height: 54px;
  border-width: 2px;
  border-color: #1f3a63;
  border-radius: 8px;
  background-color: rgba(11, 22, 40, 0.95);
  justify-content: flex-end;
  align-items: flex-end;
  padding: 2px;
  position: relative;
  transition-duration: 0.12s;
  transition-property: border-color, background-color;
}

.slot:hover {
  border-color: #4a9eff;
}

.slot__icon {
  position: absolute;
  left: 4px;
  right: 4px;
  top: 4px;
  bottom: 4px;
  tint-color: white;
}

.slot__count {
  background-color: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 11px;
  padding: 1px 3px;
  border-radius: 2px;
  -unity-text-align: middle-right;
}

/* ── 장비 슬롯 패널 (좌측 세로 1열) ─────────────────────────────
 * 인벤토리 그리드 좌측에 세로로 장비 슬롯을 배치한다.
 * 인벤토리 그리드와는 margin-right 로 간격을 확보한다.
 * align-self: flex-start 로 인벤토리 루트(row)의 교차축(세로)에서 상단 정렬한다.
 * 인벤토리 창 자체는 .inventory-scroll-content 에서 가로·세로 중앙 정렬을 유지한다. */
.equipment-panel {
  flex-shrink: 0;
  flex-direction: column;
  align-self: flex-start;
  align-items: center;
  justify-content: flex-start;
  gap: 6px;
  margin-right: 16px;
  padding: 10px 6px;
  border-width: 1px;
  border-color: #1f3a63;
  border-radius: 10px;
  background-color: rgba(6, 16, 32, 0.75);
}

.equipment-slots {
  flex-direction: column;
  gap: 6px;
  align-items: center;
}

/* 장비 슬롯: 인벤토리 슬롯과 동일한 크기(54×54), 보라 계열 테두리로 구분 */
.equipment-slot {
  width: 54px;
  height: 54px;
  border-width: 2px;
  border-color: #3a2a63;
  border-radius: 8px;
  background-color: rgba(18, 12, 40, 0.95);
  justify-content: flex-end;
  align-items: flex-end;
  padding: 2px;
  position: relative;
  transition-duration: 0.12s;
  transition-property: border-color, background-color;
}

.equipment-slot:hover {
  border-color: #a366ff;
}

/* 장비 슬롯 타입 라벨 (하단 중앙 작은 텍스트) */
.equipment-slot__label {
  position: absolute;
  bottom: 1px;
  left: 0;
  right: 0;
  font-size: 8px;
  color: #6b7891;
  -unity-text-align: middle-center;
  -unity-font-style: italic;
  pointer-events: none;
}

/* 장비 그림자 스프라이트 (z+2: UI 슬롯 배경 위에, 아이템 스프라이트 아래에)
 * 가로·세로 중앙 정렬: (100% - 70%) / 2 = 15% 오프셋, 슬롯 대비 70% 크기, 불투명도 70%. */
.equipment-slot__shadow {
  position: absolute;
  left: 15%;
  top: 15%;
  width: 70%;
  height: 70%;
  tint-color: rgba(255, 255, 255, 1);
  opacity: 0.7;
  pointer-events: none;
}

/* 아이템 스프라이트 (z+3: 최상위 — 그림자 위에 렌더링) */
.equipment-slot__icon {
  position: absolute;
  left: 4px;
  right: 4px;
  top: 4px;
  bottom: 4px;
  tint-color: white;
  pointer-events: none;
}

/* 수량 라벨 (우하단) */
.equipment-slot__count {
  background-color: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 11px;
  padding: 1px 3px;
  border-radius: 2px;
  -unity-text-align: middle-right;
  pointer-events: none;
}

.held-item-ghost {
  position: absolute;
  width: 48px;
  height: 48px;
  pointer-events: none;
}

.held-item-ghost__icon {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  tint-color: white;
}

.held-item-ghost__count {
  position: absolute;
  right: 2px;
  bottom: 2px;
  background-color: rgba(0, 0, 0, 0.65);
  color: #fff;
  font-size: 11px;
  padding: 1px 3px;
  border-radius: 2px;
  -unity-text-align: middle-right;
}

/* ── 우측 조합 패널 ───────────────────────────────────────────
 * 높이는 C#(SyncCraftingPanelHeightToInventory)에서 좌측 인벤토리 패널 높이로 고정한다.
 * 내부는 세로(column) 배치: 고정 크기 섹션들 + flex-grow 하는 조합 목록 스크롤.
 * 남는 세로 공간이 있으면 목록 스크롤 영역이 채우고, 넘치면 스크롤된다. */
.crafting-panel {
  width: 200px;
  flex-shrink: 0;
  flex-direction: column;
  align-items: stretch;
  /* 인벤토리(소유 아이템) 영역과의 가로 간격 */
  margin-left: 16px;
}

/* 조합 패널 타이틀: 소제목 느낌으로 매우 작게. 여백 최소화. */
.crafting-title {
  -unity-font-style: bold;
  font-size: 11px;
  color: #4a9eff;
  letter-spacing: 2px;
  margin-top: 0;
  margin-bottom: 2px;
  padding: 0;
  flex-shrink: 0;
}

/* (b) 선택된 레시피의 필요 아이템 표시 영역 */
.crafting-section-label {
  font-size: 9px;
  -unity-font-style: bold;
  color: #6b7891;
  letter-spacing: 1px;
  margin-bottom: 6px;
  flex-shrink: 0;
}

.crafting-requirements {
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-start;
  align-items: flex-start;
  padding: 5px;
  gap: 4px;
  border-width: 1px;
  border-color: #1f3a63;
  border-radius: 10px;
  background-color: rgba(6, 16, 32, 0.75);
  min-height: 48px;
  flex-shrink: 0;
}

.crafting-requirements__empty {
  font-size: 10px;
  color: #6b7891;
  -unity-font-style: italic;
  white-space: normal;
  -unity-text-align: middle-center;
  flex-grow: 1;
}

/* 필요 아이템 칸: 아이콘 + "보유/요구" 수량 */
.crafting-req-slot {
  width: 40px;
  height: 48px;
  border-width: 2px;
  border-color: #1f3a63;
  border-radius: 8px;
  background-color: rgba(11, 22, 40, 0.95);
  align-items: center;
  justify-content: center;
  padding: 3px 2px 2px 2px;
  overflow: hidden;
}

.crafting-req-slot__icon {
  width: 24px;
  height: 24px;
  tint-color: rgba(160, 160, 160, 1);
  opacity: 0.35;
  flex-shrink: 0;
}

.crafting-req-slot__count {
  font-size: 10px;
  -unity-font-style: bold;
  color: #4a9eff;
  -unity-text-align: middle-center;
  margin-top: 3px;
}

.crafting-req-slot--satisfied {
  border-color: #2ecc71;
  background-color: rgba(20, 52, 36, 0.95);
}

.crafting-req-slot--satisfied .crafting-req-slot__icon {
  tint-color: white;
  opacity: 1;
}

.crafting-req-slot--satisfied .crafting-req-slot__count {
  color: #2ecc71;
}

/* ── 구분선 ── */
.crafting-divider {
  height: 1px;
  background-color: rgba(74, 158, 255, 0.35);
  margin-top: 10px;
  margin-bottom: 5px;
  flex-shrink: 0;
}

/* (a) 조합 가능한 아이템 목록
 * 목록은 가변적이므로 ScrollView 로 감싸 넘칠 때 세로 스크롤한다.
 * 스크롤 영역 높이는 조합 패널(=인벤토리 높이)에 의해 제한되고, 격자 배치는 내부 .crafting-recipe-list 가 담당한다. */
.crafting-recipe-scroll {
  /* 패널의 남은 세로 공간을 채우고, 내용이 넘치면 스크롤한다.
   * 높이가 패널에 의해 제한되므로 별도의 max-height 는 두지 않는다. */
  flex-grow: 1;
  flex-shrink: 1;
  min-height: 60px;
  border-width: 1px;
  border-color: #1f3a63;
  border-radius: 10px;
  background-color: rgba(6, 16, 32, 0.75);
}

/* 슬롯을 인벤토리 그리드처럼 행 단위(column)로 쌓는다. */
.crafting-recipe-list {
  flex-direction: column;
  padding: 6px;
  gap: 5px;
}

/* 격자의 한 줄: 슬롯을 가로로 나열 */
.crafting-recipe-row {
  flex-direction: row;
  gap: 5px;
}

.crafting-recipe-list__empty {
  font-size: 10px;
  color: #6b7891;
  -unity-font-style: italic;
  white-space: normal;
  padding: 10px 4px;
  -unity-text-align: middle-center;
}

/* 레시피 슬롯: 인벤토리 슬롯과 동일한 격자형 칸(아이콘만 표시, 이름은 툴팁) */
.crafting-recipe-slot {
  width: 42px;
  height: 42px;
  border-width: 2px;
  border-color: #1f3a63;
  border-radius: 8px;
  background-color: rgba(11, 22, 40, 0.95);
  justify-content: center;
  align-items: center;
  padding: 3px;
  transition-duration: 0.12s;
  transition-property: border-color, background-color;
}

.crafting-recipe-slot:hover {
  border-color: #4a9eff;
  background-color: rgba(20, 36, 66, 0.95);
}

/* 선택된 레시피 강조 */
.crafting-recipe-slot--selected {
  border-color: #4a9eff;
  background-color: rgba(24, 44, 82, 0.98);
}

.crafting-recipe-slot__icon {
  width: 32px;
  height: 32px;
  tint-color: white;
  flex-shrink: 0;
}

/* ── 조합 목록 스크롤바 스타일 (UI Toolkit 기본 스크롤러 오버라이드) ──
 * ChatPanelUI 의 얇은 스크롤바 패턴을 조합 목록에도 동일하게 적용한다.
 * 화살표 버튼 제거 + 6px 폭의 반투명 thumb/track. */
.crafting-recipe-scroll .unity-scroll-view__viewport {
  padding-right: 4px;
}

.crafting-recipe-scroll .unity-scroller > .unity-scroller__low-button,
.crafting-recipe-scroll .unity-scroller > .unity-scroller__high-button {
  width: 0;
  height: 0;
  min-width: 0;
  min-height: 0;
  display: none;
}

.crafting-recipe-scroll .unity-scroller--vertical {
  width: 6px;
  min-width: 0;
  margin: 0;
}

.crafting-recipe-scroll .unity-scroller--vertical > .unity-scroller__slider {
  width: 6px;
  min-width: 0;
  margin: 0;
}

.crafting-recipe-scroll .unity-base-slider--vertical .unity-base-slider__dragger {
  left: 0;
  width: 6px;
  margin-right: 0;
  margin-left: 0;
}

.crafting-recipe-scroll .unity-base-slider__tracker {
  background-color: rgba(74, 158, 255, 0.15);
  border-color: transparent;
}

.crafting-recipe-scroll .unity-base-slider .unity-base-slider__dragger {
  border-width: 0;
  border-color: transparent;
  border-radius: 3px;
}

.crafting-recipe-scroll .unity-scroller--vertical .unity-base-slider__dragger {
  background-color: rgba(74, 158, 255, 0.55);
  left: 0;
  width: 6px;
}

/* ── 아이템 툴팁 ─────────────────────────────────────────────── */
.item-tooltip {
  position: absolute;
  max-width: 260px;
  min-width: 120px;
  padding: 8px 10px;
  background-color: rgba(6, 16, 32, 0.97);
  border-width: 1px;
  border-color: #2d4373;
  border-radius: 8px;
  gap: 3px;
}

.item-tooltip__name {
  -unity-font-style: bold;
  font-size: 14px;
  color: #f0f4ff;
  white-space: normal;
}

.item-tooltip__type {
  font-size: 10px;
  color: #6b7891;
  -unity-font-style: italic;
}

.item-tooltip__description {
  font-size: 12px;
  color: #cdd6e6;
  white-space: normal;
  margin-top: 2px;
}

.item-tooltip__detail {
  font-size: 11px;
  color: #a9b4c8;
  white-space: normal;
}

.item-tooltip__stack {
  font-size: 11px;
  color: #4a9eff;
  margin-top: 2px;
  -unity-text-align: middle-left;
}

/* ── 가로 스크롤바 스타일 (조합 목록 세로 스크롤바와 통일) ──────
 * 화살표 버튼 제거 + 6px 높이의 반투명 thumb/track. */
.inventory-scroll-view .unity-scroller--horizontal {
  height: 6px;
  min-height: 0;
  margin: 0;
}

.inventory-scroll-view .unity-scroller--horizontal > .unity-scroller__low-button,
.inventory-scroll-view .unity-scroller--horizontal > .unity-scroller__high-button {
  width: 0;
  height: 0;
  min-width: 0;
  min-height: 0;
  display: none;
}

.inventory-scroll-view .unity-scroller--horizontal > .unity-scroller__slider {
  height: 6px;
  min-height: 0;
  margin: 0;
}

.inventory-scroll-view .unity-base-slider--horizontal .unity-base-slider__dragger {
  top: 0;
  height: 6px;
  margin: 0;
}

.inventory-scroll-view .unity-base-slider--horizontal .unity-base-slider__tracker {
  background-color: rgba(74, 158, 255, 0.15);
  border-color: transparent;
}

.inventory-scroll-view .unity-base-slider--horizontal .unity-base-slider__dragger {
  border-width: 0;
  border-color: transparent;
  border-radius: 3px;
}

.inventory-scroll-view .unity-scroller--horizontal .unity-base-slider__dragger {
  background-color: rgba(74, 158, 255, 0.55);
  top: 0;
  height: 6px;
}
