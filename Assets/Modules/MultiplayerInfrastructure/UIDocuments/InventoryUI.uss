.inventory-ui-wrapper {
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
}

.inventory-root {
  width: 420px;
  padding: 12px;
  background-color: #c6c6c6;
  border: 2px solid #000;
  gap: 8px;
}

/*
.inventory-root--visible {
  visibility: visible;
}
.inventory-root--hidden {
  visibility: hidden;
}
*/

.inventory-title {
  -unity-font-style: bold;
  font-size: 18px;
  color: #222;
  margin-bottom: 4px;
}

.inventory-grid {
  border: 2px solid #555;
  padding: 8px;
  gap: 6px;
  flex-wrap: wrap;
  flex-direction: column;
  background-color: #bdbdbd;
  min-height: 120px;
}

.slot-row {
  flex-direction: row;
}

.slot {
  width: 54px;
  height: 54px;
  border: 2px solid #777;
  background-color: #d9d9d9;
  justify-content: flex-end;
  align-items: flex-end;
  padding: 2px;
  position: relative;
}

.slot__icon {
  position: absolute;
  left: 4px;
  right: 4px;
  top: 4px;
  bottom: 4px;
  tint-color: white;
}

.slot__count {
  background-color: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 11px;
  padding: 1px 3px;
  border-radius: 2px;
  -unity-text-align: middle-right;
}

.held-item-ghost {
  position: absolute;
  width: 48px;
  height: 48px;
  pointer-events: none;
}

.held-item-ghost__icon {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  tint-color: white;
}

.held-item-ghost__count {
  position: absolute;
  right: 2px;
  bottom: 2px;
  background-color: rgba(0, 0, 0, 0.65);
  color: #fff;
  font-size: 11px;
  padding: 1px 3px;
  border-radius: 2px;
  -unity-text-align: middle-right;
}
