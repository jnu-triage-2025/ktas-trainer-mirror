.game-menu__root {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: rgba(0, 0, 0, 0.45);
}

.game-menu__root {
  visibility: hidden;
}

.game-menu__panel {
  min-width: 240px;
  padding: 16px 20px;
  background-color: #1f1f24;
  border-radius: 8px;
  border: 1px solid #3a3a44;
  display: flex;
  flex-direction: column;
  gap: 12px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
}

.game-menu__title {
  font-size: 20px;
  font-weight: 700;
  color: #f4f4f7;
  margin-bottom: 4px;
}

.game-menu__button {
  height: 36px;
  font-size: 14px;
  font-weight: 600;
  color: #f4f4f7;
  background-color: #2d7cf4;
  border-radius: 6px;
  border: 1px solid #2d7cf4;
}

.game-menu__button:hover {
  background-color: #3a89ff;
}

.game-menu__button:active {
  background-color: #236bce;
}

.game-menu__button--secondary {
  background-color: #2f2f36;
  border-color: #44444d;
}

.game-menu__button--secondary:hover {
  background-color: #3a3a43;
}

.game-menu__button--secondary:active {
  background-color: #2a2a32;
}
