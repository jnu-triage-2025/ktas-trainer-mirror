.root {
  width: 100%;
  height: 100%;
  padding: 16px;
  box-sizing: border-box;
  background-color: #0b1220;
  color: #e5e7eb;
  flex-direction: column;
  align-items: stretch;
  gap: 12px;
}

.title {
  unity-font-style-and-weight: bold;
  font-size: 20px;
  color: #e5e7eb;
  margin-bottom: 4px;
}

.row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12px;
  width: 100%;
  align-items: flex-start;
}

.card {
  flex: 1 1 360px;
  max-width: 720px;
  min-width: 320px;
  background-color: #0f172a;
  border: 1px solid #1f2937;
  border-radius: 12px;
  padding: 16px;
  box-sizing: border-box;
  gap: 10px;
}

.direct-card {
  border: 1px solid #334155;
}

.stack {
  display: flex;
  flex-direction: column;
}

.gap {
  gap: 8px;
}

.section-title {
  margin-top: 10px;
  margin-bottom: 6px;
  unity-font-style-and-weight: bold;
  color: #e5e7eb;
}

.btn {
  height: 40px;
  unity-text-align: middle-center;
  color: #ffffff;
  border-radius: 8px;
  border-width: 0px;
  background-color: #3b82f6;
}

.btn:hover {
  background-color: #4b8ff9;
}

.btn:disabled {
  background-color: #4b5563;
  color: #cbd5e1;
}

.primary {
  background-color: #3b82f6;
}

.primary:hover {
  background-color: #4b8ff9;
}

.secondary {
  background-color: #6b7280;
}

.secondary:hover {
  background-color: #7b8490;
}

.accent {
  background-color: #22c55e;
}

.accent:hover {
  background-color: #32cf6c;
}

.session-list {
  min-height: 220px;
  max-height: 340px;
  border: 1px solid #1f2937;
  border-radius: 8px;
  background-color: #0a1022;
}

.empty-state {
  margin-top: 6px;
  color: #9ca3af;
  font-size: 12px;
}

.form-row {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-bottom: 8px;
}

.field-label {
  color: #9ca3af;
  font-size: 12px;
}

.text-field {
  height: 32px;
  border: 1px solid #1f2937;
  border-radius: 6px;
  background-color: #0a0f1a;
  color: #e5e7eb;
}

.status {
  color: #9ca3af;
  font-size: 12px;
}
