/* ═══════════════════════════════════════════════════════════════
   SceneUIIntroScene.uss — Intro Scene UI Styles
   ═══════════════════════════════════════════════════════════════ */

.root {
  width: 100%;
  height: 100%;
  padding-left: 16px;
  padding-right: 16px;
  padding-top: 16px;
  padding-bottom: 16px;
  background-color: #0b1220;
  color: #e5e7eb;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

/* ─── Centered card ─────────────────────────────────────────── */
.intro-card {
  background-color: #0f172a;
  border: 1px solid #1f2937;
  border-radius: 12px;
  padding: 24px;
  width: 100%;
  min-width: 0;
  max-width: 560px;
  max-height: 100%;
  flex-shrink: 1;
  box-sizing: border-box;
}

/* ─── Panels (screen switching) ─────────────────────────────── */
.panel {
  flex-direction: column;
  gap: 16px;
  min-width: 0;
  flex-shrink: 1;
}

.panel-wide {
  width: 100%;
}

/* ─── Form elements ─────────────────────────────────────────── */
.form-row {
  flex-direction: column;
  gap: 4px;
  margin-bottom: 4px;
}

.field-label {
  color: #9ca3af;
  font-size: 12px;
}

.text-field {
  height: 36px;
  border: 1px solid #1f2937;
  border-radius: 6px;
  background-color: #0a0f1a;
  padding-left: 8px;
  padding-right: 8px;
}

/* TextField의 실제 입력 요소와 placeholder 상태는 별도 USS 클래스다.
   루트나 내부 컨테이너에 색을 주면 상태별 색이 뒤섞일 수 있으므로 직접 지정한다. */
.text-field .unity-base-text-field__input {
  color: #354a67;
}

.text-field .unity-base-text-field__input--placeholder {
  color: #6e7b93;
}

.text-field:focus-within {
  border: 1px solid #3b82f6;
}

/* ─── Buttons ───────────────────────────────────────────────── */
.btn {
  min-height: 38px;
  height: 38px;
  flex-shrink: 1;
  -unity-text-align: middle-center;
  color: #ffffff;
  border-radius: 8px;
  border-width: 0;
  font-size: 14px;
}

.btn:hover {
  opacity: 0.9;
}

.btn:disabled {
  background-color: #4b5563;
  color: #cbd5e1;
}

.btn-primary {
  background-color: #3b82f6;
}

.btn-primary:hover {
  background-color: #4b8ff9;
}

.btn-secondary {
  background-color: #6366f1;
}

.btn-secondary:hover {
  background-color: #7577f5;
}

.btn-tertiary {
  background-color: #6b7280;
}

.btn-tertiary:hover {
  background-color: #7b8490;
}

.btn-accent {
  background-color: #22c55e;
}

.btn-accent:hover {
  background-color: #32cf6c;
}

.btn-danger {
  background-color: #dc2626;
}

.btn-danger:hover {
  background-color: #e53e3e;
}

/* ─── Layout helpers ────────────────────────────────────────── */
.stack {
  flex-direction: column;
}

.gap {
  gap: 8px;
}

.btn-row {
  flex-direction: row;
  gap: 8px;
}

.btn-row.center {
  justify-content: center;
}

.btn-half {
  flex: 1 1 0;
}

.btn-host {
  min-height: 44px;
  height: 44px;
  font-size: 14px;
  -unity-font-style-and-weight: bold;
}

/* ─── Session list ──────────────────────────────────────────── */
.session-box {
  background-color: #0a1022;
  border: 1px solid #1f2937;
  border-radius: 8px;
  padding: 8px;
  gap: 6px;
}

.search-field {
  height: 32px;
  background-color: #111827;
  border: 1px solid #374151;
}

.session-list {
  min-height: 100px;
  max-height: 180px;
  flex: 1 1 auto;
  flex-shrink: 1;
  border: 1px solid #1f2937;
  border-radius: 4px;
  background-color: #0a1022;
}

.session-row-name {
  -unity-font-style-and-weight: bold;
  color: #e5e7eb;
}

.session-row-endpoint {
  color: #94a3b8;
  font-size: 11px;
}

.empty-state {
  color: #6b7280;
  font-size: 12px;
  -unity-text-align: middle-center;
  margin-top: 4px;
  margin-bottom: 4px;
}

/* ─── Status bar ────────────────────────────────────────────── */
.status {
  color: #6b7280;
  font-size: 11px;
  -unity-text-align: middle-center;
  margin-top: 8px;
}
