:root {
  --keyhint-background-dark: rgba(30, 36, 44, .85);
  --keyhint-border-dark: rgba(255, 255, 255, 0.1);
  --content-background-dark: rgba(18, 22, 28, 0.78);
}

.interactable-scroll {
  flex-grow: 1;
}

.interactable-hint {
  flex-direction: row;
  align-items: center;
}

.interactable-hint > .interact-key-hint {
  opacity: 0;
}
.interactable-hint.selected > .interact-key-hint {
  opacity: 1;
}

.interactable-hint {
  margin-bottom: 5px;
}

.interactable-hint .interact-key-hint {
  align-items: center;
  justify-content: center;
  -unity-text-align: middle-center;
  color: var(--keyhint-background-dark);

  /* 높이를 고정하고 overflow를 visible로 두어, 내부 힌트 아이콘(마우스 스크롤 아이콘 등)의
     크기가 이후 커지더라도 이 영역의 레이아웃 높이는 변하지 않는다.
     이렇게 해서 옆에 있는 "현재 선택된 Interactable 옵션" 영역의 세로 간격/높이가
     힌트 아이콘 크기 변경과 독립적으로 유지된다. */
  height: 20px;
  overflow: visible;
}

.interactable-hint .interact-key-hint .interact-scroll-hint {
  width: 20px;
  height: 20px;
  margin-right: 6px;
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
}

.interactable-hint .interact-key-hint .interact-key-text {
  -unity-text-align: middle-center;
  white-space: normal;
  font-size: 80%;
  -unity-font-style: bold;

  background-color: #fff;
  width: 20px;
  height: 20px;
  border-radius: 5px;
}

.interactable-hint .interactable-content-wrapper {
  padding-left: 5px;
  padding-right: 44px;

  /* 텍스트 길이와 무관하게 모든 메뉴 항목을 같은 길이로 유지한다. */
  width: 260px;
  min-width: 260px;
  max-width: 260px;
  flex-shrink: 0;
  overflow: visible;
}

.interactable-hint .interactable-content-row {
  flex-direction: row;
  align-items: center;
  column-gap: 8px;
}

.interactable-hint .interactable-icon-holder {
  width: 28px;
  height: 28px;
  min-width: 28px;
  min-height: 28px;
  border-radius: 6px;
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
  opacity: 0.95;
}

.interactable-hint .interactable-content-text {
  color: white;
  font-size: 18px;
  -unity-font-style: bold;
  -unity-text-outline-width: 0.75px;
  -unity-text-outline-color: rgba(0, 0, 0, 0.70);

  /* 배경을 넘어 일정 거리까지 표시하고, 그 이후에만 말줄임 처리한다. */
  width: 340px;
  max-width: 340px;
  flex-shrink: 0;
  flex-grow: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
