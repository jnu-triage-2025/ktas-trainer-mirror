<ui:UXML
  xmlns:ui="UnityEngine.UIElements"
>
  <ui:Style src="./SettingsUI.uss" />

  <!-- 전체 화면 반투명 배경 -->
  <ui:VisualElement name="settings-root" class="settings__root">

    <!-- 중앙 패널 -->
    <ui:VisualElement class="settings__panel">

      <!-- 헤더 -->
      <ui:VisualElement class="settings__header">
        <ui:Label class="settings__title" text="설정" />
        <ui:Button name="close-button" class="settings__close-btn" text="✕" />
      </ui:VisualElement>

      <!-- 탭 바 (C# 컨트롤러가 탭 버튼을 동적으로 채웁니다) -->
      <ui:VisualElement name="tab-bar" class="settings__tab-bar" />

      <!-- 구분선 -->
      <ui:VisualElement class="settings__divider" />

      <!-- 탭 컨텐츠 영역 (C# 컨트롤러가 활성 탭 컨텐츠를 동적으로 채웁니다) -->
      <ui:VisualElement name="tab-content" class="settings__tab-content" />

      <!-- 하단 푸터 (상태 라벨 등) -->
      <ui:VisualElement class="settings__footer">
        <ui:Label name="status-label" class="settings__status" text="" />
      </ui:VisualElement>

    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
