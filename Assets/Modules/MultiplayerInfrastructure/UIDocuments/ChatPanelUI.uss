:root {
  --bg: rgba(0, 0, 0, 0.65);
  --toast-bg: rgba(0, 0, 0, 0.78);
  --font-size: 12px;
  --panel-width: 420px;
  --entry-gap: 6px;
  --scroller-width: 8px;
  --accent: #59d07f;
}

.chat-root {
  position: absolute;
  left: 18px;
  bottom: 18px;
  /* Fixed width so the chat never resizes with message/input length. */
  width: var(--panel-width);
  min-width: var(--panel-width);
  max-width: var(--panel-width);
  display: flex;
  flex-direction: column;
  /* Stretch so children always fill the fixed panel width. */
  align-items: stretch;
  justify-content: flex-end;
  flex-shrink: 0;
  flex-grow: 0;
  gap: 8px;
}

.chat-panel {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  width: 100%;
  gap: 8px;
  pointer-events: auto;
}

.chat-root.collapsed .chat-panel {
  display: none;
  opacity: 0;
  pointer-events: none;
  visibility: hidden;
}

.chat-root.expanded .chat-panel {
  display: flex;
  opacity: 1;
  visibility: visible;
}

.chat-log-frame {
  position: relative;
  width: 100%;
  min-height: 200px;
  height: 200px;
  flex-shrink: 0;
  margin-bottom: 8px;
}

.chat-log {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: var(--bg);
  padding: 8px 24px 8px 10px;
  width: 100%;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 6px;
  align-items: stretch;
}

.chat-log .unity-scroll-view__viewport {
  padding-right: 0;
}

.chat-log-content {
  flex-direction: column;
  justify-content: flex-start;
  gap: var(--entry-gap);
  width: 100%;
}

.chat-scrollbar-track {
  position: absolute;
  right: 7px;
  top: 10px;
  bottom: 10px;
  width: var(--scroller-width);
  background-color: rgba(255, 255, 255, 0.08);
  border-radius: 4px;
}

.chat-scrollbar-thumb {
  position: absolute;
  left: 1px;
  top: 0;
  width: 6px;
  min-height: 28px;
  background-color: rgba(89, 208, 127, 0.62);
  border-radius: 3px;
}

.chat-scrollbar-thumb:hover {
  background-color: rgba(108, 226, 146, 0.86);
}

.chat-scrollbar-thumb:active,
.chat-scrollbar-thumb.dragging {
  background-color: rgb(89, 208, 127);
}

.chat-scrollbar-thumb.disabled {
  background-color: rgba(89, 208, 127, 0.28);
}

.chat-log__entry {
  white-space: pre-wrap;
  color: #f5f7f2;
  font-size: var(--font-size);
  line-height: 1.35;
  letter-spacing: 0.02em;
}

.chat-input-row {
  flex-direction: column;
  width: 100%;
}

.chat-input-bg {
  background-color: rgba(0, 0, 0, 0.82);
  padding: 10px 12px;
  width: 100%;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 6px;
}

.chat-input {
  width: 100%;
  color: #ffffff;
  background-color: transparent;
  border: none;
  font-size: var(--font-size);
  letter-spacing: 0.02em;
}

.chat-input .unity-base-text-field__input {
  background-color: transparent;
  border: 0;
  border-color: transparent;
  color: #ffffff;
  padding: 0;
}

.chat-completion-overlay {
  position: absolute;
  bottom: 100%;
  left: 0;
  margin-bottom: 2px;
  flex-direction: column;
  align-items: flex-start;
  pointer-events: none;
}

.chat-completion-list {
  flex-direction: column;
  background-color: rgba(0, 0, 0, 0.82);
  padding: 4px 8px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 6px;
}

.chat-completion-row {
  flex-direction: row;
  align-items: center;
  padding: 0 4px;
}

.chat-completion-row--selected {
  background-color: rgba(89, 208, 127, 0.28);
}

.chat-completion-row__label {
  color: #ffffff;
  font-size: var(--font-size);
  margin-right: 10px;
}

.chat-completion-row--selected .chat-completion-row__label {
  color: #d9ffe6;
}

.chat-completion-row__description {
  color: rgba(255, 255, 255, 0.45);
  font-size: 11px;
}

.chat-completion-more {
  color: rgba(255, 255, 255, 0.45);
  font-size: 11px;
}

.chat-toast-container {
  position: absolute;
  left: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
  width: 100%;
  pointer-events: none;
}

.chat-toast {
  background-color: var(--toast-bg);
  color: #fdfdf2;
  padding: 6px 10px;
  font-size: var(--font-size);
  line-height: 1.3;
  border-left: 2px solid var(--accent);
  opacity: 0;
}

.chat-toast__label {
  white-space: pre-wrap;
}
