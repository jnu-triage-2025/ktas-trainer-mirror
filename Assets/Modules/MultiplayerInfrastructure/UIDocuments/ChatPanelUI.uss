:root {
  --bg: rgba(0, 0, 0, 0.65);
  --toast-bg: rgba(0, 0, 0, 0.78);
  --font-size: 12px;
  --panel-width: 420px;
  --entry-gap: 6px;
  --scroller-width: 6px;
  --accent: #59d07f;
}

.chat-root {
  position: absolute;
  left: 18px;
  bottom: 18px;
  width: var(--panel-width);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-end;
  flex-shrink: 0;
  flex-grow: 0;
  gap: 8px;
  z-index: 200;
}

.chat-panel {
  display: flex;
  flex-direction: column;
  gap: 8px;
  pointer-events: auto;
  transition: opacity 0.12s ease-in-out, visibility 0.12s ease-in-out;
}

.chat-root.collapsed .chat-panel {
  display: none;
  opacity: 0;
  pointer-events: none;
  visibility: hidden;
}

.chat-root.expanded .chat-panel {
  display: flex;
  opacity: 1;
  visibility: visible;
}

.chat-log {
  background-color: var(--bg);
  padding: 8px 10px;
  min-height: 140px;
  height: 200px;
  flex-shrink: 0;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 6px;
  align-items: stretch;
}

.chat-log .unity-scroll-view__viewport {
  padding-right: 6px;
}

.chat-log .unity-scroll-view__content-container {
  flex-direction: column;
  justify-content: flex-start;
  gap: var(--entry-gap);
  width: 100%;
}

.chat-log .unity-scroller > .unity-scroller__low-button,
.chat-log .unity-scroller > .unity-scroller__high-button {
  width: 0;
  height: 0;
  min-width: 0;
  min-height: 0;
  display: none;
}

.chat-log .unity-scroller--vertical {
  width: var(--scroller-width);
  min-width: 0;
  margin: 0;
}

.chat-log .unity-scroller--vertical > .unity-scroller__slider {
  width: var(--scroller-width);
  min-width: 0;
  margin: 0;
}

.chat-log .unity-base-slider--vertical .unity-base-slider__dragger {
  left: 0;
  width: var(--scroller-width);
  margin-right: 0;
  margin-left: 0;
}

.chat-log .unity-base-slider__tracker {
  background-color: rgba(255, 255, 255, 0.2);
  border-color: transparent;
}

.chat-log .unity-base-slider .unity-base-slider__dragger {
  border-width: 0;
  border-color: transparent;
}

.chat-log .unity-scroller--vertical .unity-base-slider__dragger {
  background-color: rgba(255, 255, 255, 0.55);
  left: 0;
  width: var(--scroller-width);
}

.chat-log__entry {
  white-space: pre-wrap;
  word-break: break-word;
  color: #f5f7f2;
  font-size: var(--font-size);
  line-height: 1.35;
  letter-spacing: 0.02em;
}

.chat-input-row {
  flex-direction: column;
}

.chat-input-bg {
  background-color: rgba(0, 0, 0, 0.82);
  padding: 10px 12px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 6px;
}

.chat-input {
  width: 100%;
  color: #ffffff;
  background-color: transparent;
  border: none;
  font-size: var(--font-size);
  letter-spacing: 0.02em;
}

.chat-input .unity-base-text-field__input {
  background-color: transparent;
  border: 0;
  border-color: transparent;
  color: #ffffff;
  padding: 0;
}

.chat-toast-container {
  position: absolute;
  left: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
  width: var(--panel-width);
  pointer-events: none;
  z-index: 201;
}

.chat-toast {
  background-color: var(--toast-bg);
  color: #fdfdf2;
  padding: 6px 10px;
  font-size: var(--font-size);
  line-height: 1.3;
  border-left: 2px solid var(--accent);
  opacity: 0;
  transition: opacity 0.15s ease-in-out;
}

.chat-toast__label {
  white-space: pre-wrap;
  word-break: break-word;
}
