.held-item-hud {
  position: absolute;
  right: 48px;
  bottom: 36px;
  width: 88px;
  height: 88px;
  justify-content: center;
  align-items: center;
  background-color: rgba(10, 10, 10, 0.35);
  border: 2px solid rgba(255, 255, 255, 0.22);
  border-radius: 12px;
  opacity: 0.9;
  pointer-events: none;
  transform: rotate(-12deg);
  -unity-font-definition: var(--unity-default-font);
}

.held-item-hud__icon {
  width: 58px;
  height: 58px;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.held-item-hud__count {
  position: absolute;
  right: 8px;
  bottom: 6px;
  font-size: 14px;
  color: #f5f5f5;
  -unity-font-definition: var(--unity-default-font);
  -unity-text-outline-color: rgba(0, 0, 0, 0.85);
  -unity-text-outline-width: 1px;
}

.held-item-hud--attack {
  transform: rotate(-4deg) scale(1.12);
  opacity: 1;
}

.held-item-hud--use {
  transform: rotate(-12deg) translate(0, 6px) scale(0.96);
  opacity: 1;
}
