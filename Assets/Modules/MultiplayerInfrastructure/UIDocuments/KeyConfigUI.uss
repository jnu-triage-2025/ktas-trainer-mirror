/* ============================================================
   키 설정 UI — KeyConfigUI.uss
   ============================================================ */

/* ── 전체 화면 오버레이 ─────────────────────────────────────── */
.key-config__root {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: rgba(0, 0, 0, 0.55);
}

/* 에디터/런타임 초기 상태: 컨트롤러가 Show() 호출 전에는 보이지 않도록 */
.key-config__root {
  opacity: 0;
}

/* ── 중앙 패널 ───────────────────────────────────────────────── */
.key-config__panel {
  min-width: 960px;
  max-width: 1280px;
  height: 78%;
  background-color: #1c1c22;
  border-radius: 10px;
  border-width: 1px;
  border-color: #3a3a46;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* ── 헤더 ────────────────────────────────────────────────────── */
.key-config__header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.key-config__title {
  font-size: 18px;
  color: #f0f0f5;
  -unity-font-style: bold;
}

.key-config__close-btn {
  width: 28px;
  height: 28px;
  font-size: 14px;
  color: #aaaabc;
  background-color: #2a2a34;
  border-radius: 6px;
  border-width: 1px;
  border-color: #44444e;
  padding: 0;
}

.key-config__close-btn:hover {
  background-color: #3a3a46;
  color: #f0f0f5;
}

.key-config__close-btn:active {
  background-color: #c0392b;
  color: #ffffff;
  border-color: #c0392b;
}

/* ── 본문 레이아웃 ───────────────────────────────────────────── */
.key-config__content {
  display: flex;
  flex-direction: row;
  gap: 20px;
  flex-grow: 1;
  flex-shrink: 1;
  min-height: 0;
}

/* ── 사이드 패널 공통 타이틀 ─────────────────────────────────── */
.key-config__panel-title {
  font-size: 12px;
  color: #7878a0;
  -unity-font-style: bold;
  margin-bottom: 8px;
  padding-left: 4px;
  border-bottom-width: 1px;
  border-color: #2e2e3a;
  padding-bottom: 6px;
}

/* ── 좌측: 기능 목록 패널 ────────────────────────────────────── */
.key-config__list-panel {
  width: 220px;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
}

.key-config__scroll {
  flex-grow: 1;
  background-color: #17171e;
  border-radius: 6px;
  border-width: 1px;
  border-color: #2e2e3a;
}

/* ScrollView 내부 콘텐츠 패딩 */
.key-config__scroll > #unity-content-container {
  padding: 4px;
}

/* ── 우측: 키보드 패널 ───────────────────────────────────────── */
.key-config__keyboard-panel {
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

/* 키보드 요소 — 높이는 이 값으로 직접 조정. USS만 수정하면 됨 */
.key-config__keyboard {
  width: 100%;
  height: 210px;
  flex-shrink: 0;
}

/* ============================================================
   KeyboardLayoutElement 내부 스타일
   ============================================================ */

.keyboard-layout {
  /* 높이는 .key-config__keyboard { height: ... } 로 조정 */
  width: 100%;
  height: 100%;
  overflow: visible;  /* 키가 잘리지 않도록 */
  border-radius: 8px;
  background-color: #c8c8c8;
  padding: 2px;
}

/* keyboard-layout__bg 는 삭제됨 (이미지 제거 후 C#에서 생성하지 않음) */
.keyboard-layout__bg {
  display: none;
}

.keyboard-layout__overlay-container {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

/* ── 키 오버레이 기본 ─────────────────────────────────────────── */
.keyboard-layout__key {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: flex-start;
  padding: 0px 1px;
  border-radius: 4px;
  background-color: #f5f5f5;
  border-width: 1px;
  border-color: #9e9e9e;
}

.keyboard-layout__key:hover {
  background-color: #e0e0e0;
  border-color: #777777;
}

.keyboard-layout__key:active {
  background-color: #c8c8c8;
  border-color: #555555;
}

/* 키 이름 레이블 (우측 상단, 작은 텍스트) */
.keyboard-layout__key-name {
  font-size: 5px;
  color: rgba(30, 30, 30, 0.75);
  -unity-text-align: upper-right;
  overflow: hidden;
  white-space: nowrap;
  margin: 0;
  padding: 0;
}

/* 기능 레이블 (중앙, 할당 시 표시) */
.keyboard-layout__key-action {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 8px;
  font-size: 5px;
  -unity-font-style: bold;
  color: #1a4a99;
  -unity-text-align: middle-center;
  overflow: hidden;
  white-space: nowrap;
}

/* ── 할당된 키 ────────────────────────────────────────────────── */
.keyboard-layout__key--assigned {
  background-color: #dbeafe;
  border-radius: 4px;
  border-width: 1px;
  border-color: #3b82f6;
}

.keyboard-layout__key--assigned:hover {
  background-color: #bfdbfe;
  border-color: #2563eb;
}

.keyboard-layout__key--assigned:active {
  background-color: #93c5fd;
  border-color: #1d4ed8;
}

/* ── 강조된 키 (목록에서 포커스된 항목에 해당) ───────────────── */
.keyboard-layout__key--highlighted {
  background-color: #fef9c3;
  border-width: 2px;
  border-color: #eab308;
  border-radius: 4px;
}

.keyboard-layout__key--highlighted .keyboard-layout__key-action {
  color: #7a4800;  /* 노란 배경 위에서 가독성 확보 */
}

/* ============================================================
   KeyConfigEntryElement 스타일
   ============================================================ */

.key-config-entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 4px 6px;
  border-radius: 5px;
  margin-bottom: 1px;
  /* cursor: link 제거 — 런타임에서 텍스처 없는 커서 오류 */
}

.key-config-entry:hover {
  background-color: rgba(255, 255, 255, 0.06);
}

.key-config-entry:active {
  background-color: rgba(255, 255, 255, 0.10);
}

/* 기능 이름 */
.key-config-entry__action {
  font-size: 11px;
  color: #d4d4e8;
  flex-grow: 1;
  white-space: nowrap;
  overflow: hidden;
}

/* 키 뱃지 */
.key-config-entry__key {
  font-size: 10px;
  color: #a0a0c8;
  background-color: #2a2a38;
  border-radius: 4px;
  border-width: 1px;
  border-color: #44445a;
  padding: 1px 5px;
  -unity-font-style: bold;
  min-width: 36px;
  -unity-text-align: middle-center;
  white-space: nowrap;
}

/* ── 포커스(강조) 상태 ───────────────────────────────────────── */
.key-config-entry--focused {
  background-color: rgba(240, 200, 50, 0.15);
  border-width: 1px;
  border-color: rgba(240, 200, 50, 0.5);
  border-radius: 5px;
}

.key-config-entry--focused .key-config-entry__action {
  color: #fff176;
}

.key-config-entry--focused .key-config-entry__key {
  border-color: rgba(240, 200, 50, 0.7);
  color: #fff176;
  background-color: rgba(240, 200, 50, 0.18);
}

/* ── 선택 상태 ───────────────────────────────────────────────── */
.key-config-entry--selected {
  background-color: rgba(45, 124, 244, 0.20);
  border-width: 1px;
  border-color: rgba(45, 124, 244, 0.55);
  border-radius: 5px;
}

.key-config-entry--selected .key-config-entry__action {
  color: #a8c8ff;
}

.key-config-entry--selected .key-config-entry__key {
  border-color: rgba(45, 124, 244, 0.7);
  color: #a8c8ff;
  background-color: rgba(45, 124, 244, 0.22);
}
