{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": { "const": "scenario-ingame-requirements-candidates" },
    "schemaVersion": { "const": 1 },
    "scenarioIdentifier": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "enum": ["Entity", "Npc", "Interactable", "SpatialAnchor", "SpawnPoint", "EntityPreset", "ItemDefinition", "EventHandler", "RegistryEntry", "RuntimeSignal", "AudioResource", "SpriteResource", "TtsTranscript", "TtsVoice", "QuestDefinition", "PlayerTagState", "RuntimeEntityReference", "Service"] },
          "identifier": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "capabilities": { "type": "array", "uniqueItems": true, "items": { "enum": ["RegisteredEntity", "ResolvableNpcMoveTarget", "RegisteredNpcComponent", "ProvidesPosition", "HighlightableWaypoint", "Interactable", "ToggleableInteractable", "ItemSubmissionTarget", "ScenarioEntityInitTarget", "ScenarioTriageAssessTarget", "PatientMedicalStateTarget", "SpawnablePreset", "InvokableEventHandler", "LoadableResource", "ResolvableQuestDefinition"] } },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "object", "properties": { "nodeIdentifier": { "type": "string", "minLength": 1 }, "nodeType": { "type": "string", "minLength": 1 }, "fieldPath": { "type": "string", "minLength": 1 } }, "required": ["nodeIdentifier", "nodeType", "fieldPath"], "additionalProperties": false } },
          "suggestedBinding": { "type": ["object", "null"], "properties": { "mode": { "enum": ["ExistingSceneObject", "GeneratedSceneObject", "PrefabInstance", "RegistryProvided", "RuntimeProduced", "External"] }, "factoryIdentifier": { "type": ["string", "null"] }, "scope": { "enum": ["AnyLoadedScene", "Bootstrap", "SystemOverlay", "Overworld", "Content", "DontDestroyOnLoad"] }, "authority": { "enum": ["Any", "Server", "Client", "HostOnly"] } }, "required": ["mode"], "additionalProperties": false },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reviewRequired": { "type": "boolean" },
          "notes": { "type": ["string", "null"] }
        },
        "required": ["kind", "identifier", "evidence", "confidence", "reviewRequired"], "additionalProperties": false
      }
    }
  },
  "required": ["format", "schemaVersion", "scenarioIdentifier", "candidates"], "additionalProperties": false
}
