{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schema/multiplayer-scenario.schema.json",
  "title": "ScenarioGraph",
  "type": "object",
  "properties": {
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nodes": {
      "type": "object",
      "description": "Dictionary<string, IScenarioNode>",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/ScenarioNode"
      }
    }
  },
  "required": [
    "identifier",
    "nodes"
  ],
  "additionalProperties": false,
  "$defs": {
    "ScenarioNode": {
      "type": "object",
      "required": [
        "identifier",
        "nodeType"
      ],
      "properties": {
        "nodeType": {
          "type": "string",
          "enum": [
            "Dialogue",
            "Choice",
            "Sound",
            "PlayerMove",
            "NPCMove",
            "CameraTarget",
            "InvokeEvent",
            "Validator",
            "Parallel",
            "QuestControl",
            "QuestWaypointHighlight",
            "Delay",
            "Interaction",
            "CombineItem",
            "Quiz",
            "StateUpdate",
            "PlayTTS",
            "PlayerTag",
            "TagModification",
            "EntityPresetSpawn",
            "EntityTag"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "nodeType": {
                "const": "Dialogue"
              }
            },
            "required": [
              "nodeType"
            ]
          },
          "then": {
            "$ref": "#/$defs/ScenarioDialogueNode"
          }
        },
        {
          "if": {
            "properties": {
              "nodeType": {
                "const": "Choice"
              }
            },
            "required": [
              "nodeType"
            ]
          },
          "then": {
            "$ref": "#/$defs/ScenarioChoiceNode"
          }
        },
        {
          "if": {
            "properties": {
              "nodeType": {
                "const": "Sound"
              }
            },
            "required": [
              "nodeType"
            ]
          },
          "then": {
            "$ref": "#/$defs/ScenarioSoundNode"
          }
        },
        {
          "if": {
            "properties": {
              "nodeType": {
                "const": "PlayerMove"
              }
            },
            "required": [
              "nodeType"
            ]
          },
          "then": {
            "$ref": "#/$defs/ScenarioPlayerMoveNode"
          }
        },
        {
          "if": {
            "properties": {
              "nodeType": {
                "const": "NPCMove"
              }
            },
            "required": [
              "nodeType"
            ]
          },
          "then": {
            "$ref": "#/$defs/ScenarioNPCMoveNode"
          }
        },
        {
          "if": {
            "properties": {
              "nodeType": {
                "const": "CameraTarget"
              }
            },
            "required": [
              "nodeType"
            ]
          },
          "then": {
            "$ref": "#/$defs/ScenarioCameraTargetNode"
          }
        },
        {
          "if": {
            "properties": {
              "nodeType": {
                "const": "InvokeEvent"
              }
            },
            "required": [
              "nodeType"
            ]
          },
          "then": {
            "$ref": "#/$defs/ScenarioInvokeEventNode"
          }
        },
        {
          "if": {
            "properties": {
              "nodeType": {
                "const": "Validator"
              }
            },
            "required": [
              "nodeType"
            ]
          },
          "then": {
            "$ref": "#/$defs/ScenarioValidatorNode"
          }
        },
        {
          "if": {
            "properties": {
              "nodeType": {
                "const": "Parallel"
              }
            },
            "required": [
              "nodeType"
            ]
          },
          "then": {
            "$ref": "#/$defs/ScenarioParallelNode"
          }
        },
        {
          "if": {
            "properties": {
              "nodeType": {
                "const": "QuestControl"
              }
            },
            "required": [
              "nodeType"
            ]
          },
          "then": {
            "$ref": "#/$defs/ScenarioQuestControlNode"
          }
        },
        {
          "if": {
            "properties": {
              "nodeType": {
                "const": "QuestWaypointHighlight"
              }
            },
            "required": [
              "nodeType"
            ]
          },
          "then": {
            "$ref": "#/$defs/ScenarioQuestWaypointHighlightNode"
          }
        },
        {
          "if": {
            "properties": {
              "nodeType": {
                "const": "Delay"
              }
            },
            "required": [
              "nodeType"
            ]
          },
          "then": {
            "$ref": "#/$defs/ScenarioDelayNode"
          }
        },
        {
          "if": {
            "properties": {
              "nodeType": {
                "const": "Interaction"
              }
            },
            "required": [
              "nodeType"
            ]
          },
          "then": {
            "$ref": "#/$defs/ScenarioInteractionNode"
          }
        },
        {
          "if": {
            "properties": {
              "nodeType": {
                "const": "CombineItem"
              }
            },
            "required": [
              "nodeType"
            ]
          },
          "then": {
            "$ref": "#/$defs/ScenarioCombineItemNode"
          }
        },
        {
          "if": {
            "properties": {
              "nodeType": {
                "const": "Quiz"
              }
            },
            "required": [
              "nodeType"
            ]
          },
          "then": {
            "$ref": "#/$defs/ScenarioQuizNode"
          }
        },
        {
          "if": {
            "properties": {
              "nodeType": {
                "const": "StateUpdate"
              }
            },
            "required": [
              "nodeType"
            ]
          },
          "then": {
            "$ref": "#/$defs/ScenarioStateUpdateNode"
          }
        },
        {
          "if": {
            "properties": {
              "nodeType": {
                "const": "PlayTTS"
              }
            },
            "required": [
              "nodeType"
            ]
          },
          "then": {
            "$ref": "#/$defs/ScenarioPlayTTSNode"
          }
        },
        {
          "if": {
            "properties": {
              "nodeType": {
                "enum": [
                  "PlayerTag",
                  "TagModification"
                ]
              }
            },
            "required": [
              "nodeType"
            ]
          },
          "then": {
            "$ref": "#/$defs/ScenarioPlayerTagNode"
          }
        },
        {
          "if": {
            "properties": {
              "nodeType": {
                "const": "EntityPresetSpawn"
              }
            },
            "required": [
              "nodeType"
            ]
          },
          "then": {
            "$ref": "#/$defs/ScenarioEntityPresetSpawnNode"
          }
        },
        {
          "if": {
            "properties": {
              "nodeType": {
                "const": "EntityTag"
              }
            },
            "required": [
              "nodeType"
            ]
          },
          "then": {
            "$ref": "#/$defs/ScenarioEntityTagNode"
          }
        }
      ]
    },
    "ScenarioBaseNode": {
      "type": "object",
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "nextIdentifier": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "identifier"
      ],
      "additionalProperties": true
    },
    "ScenarioDialogueNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "Dialogue"
            },
            "speakerName": {
              "type": "string"
            },
            "dialogueContent": {
              "type": "string"
            },
            "portraitSpriteIdentifier": {
              "type": [
                "string",
                "null"
              ]
            },
            "autoAdvanceSeconds": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "speakerName",
            "dialogueContent"
          ]
        }
      ]
    },
    "ScenarioChoiceNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "Choice"
            },
            "speakerName": {
              "type": "string"
            },
            "dialogueContent": {
              "type": "string"
            },
            "portraitSpriteIdentifier": {
              "type": [
                "string",
                "null"
              ]
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/ScenarioChoiceOption"
              }
            },
            "nextIdentifier": {
              "type": "null"
            }
          },
          "required": [
            "speakerName",
            "dialogueContent",
            "options"
          ]
        }
      ]
    },
    "ScenarioChoiceOption": {
      "type": "object",
      "properties": {
        "displayText": {
          "type": "string"
        },
        "displayIconIdentifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "displayColor": {
          "$ref": "#/$defs/ScenarioColor"
        },
        "nextNodeIdentifier": {
          "type": "string"
        }
      },
      "required": [
        "displayText",
        "nextNodeIdentifier"
      ],
      "additionalProperties": false
    },
    "ScenarioColor": {
      "type": "object",
      "properties": {
        "r": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "g": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "b": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "a": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "r",
        "g",
        "b",
        "a"
      ],
      "additionalProperties": false
    },
    "ScenarioSoundNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "Sound"
            },
            "soundResourceIdentifier": {
              "type": "string"
            },
            "waitUntilFinished": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "soundResourceIdentifier"
          ]
        }
      ]
    },
    "ScenarioPlayerMoveNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "PlayerMove"
            },
            "destinationType": {
              "type": "string",
              "enum": [
                "Position",
                "Waypoint"
              ]
            },
            "destinationIdentifier": {
              "type": [
                "string",
                "null"
              ]
            },
            "destinationX": {
              "type": [
                "number",
                "null"
              ]
            },
            "destinationY": {
              "type": [
                "number",
                "null"
              ]
            },
            "destinationZ": {
              "type": [
                "number",
                "null"
              ]
            },
            "ignoreGroundCheck": {
              "type": "boolean",
              "default": false
            },
            "moveMode": {
              "type": "string",
              "enum": [
                "Instant",
                "BySpeed",
                "ByDuration"
              ],
              "default": "BySpeed"
            },
            "moveSpeed": {
              "type": [
                "number",
                "null"
              ]
            },
            "moveDuration": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "destinationType"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "destinationType": {
                    "const": "Position"
                  }
                }
              },
              "then": {
                "required": [
                  "destinationX",
                  "destinationY",
                  "destinationZ"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "destinationType": {
                    "const": "Waypoint"
                  }
                }
              },
              "then": {
                "required": [
                  "destinationIdentifier"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "moveMode": {
                    "const": "BySpeed"
                  }
                }
              },
              "then": {
                "required": [
                  "moveSpeed"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "moveMode": {
                    "const": "ByDuration"
                  }
                }
              },
              "then": {
                "required": [
                  "moveDuration"
                ]
              }
            }
          ]
        }
      ]
    },
    "ScenarioNPCMoveNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "NPCMove"
            },
            "npcIdentifier": {
              "type": "string"
            },
            "destinationType": {
              "type": "string",
              "enum": [
                "Position",
                "Waypoint"
              ]
            },
            "destinationIdentifier": {
              "type": [
                "string",
                "null"
              ]
            },
            "destinationX": {
              "type": [
                "number",
                "null"
              ]
            },
            "destinationY": {
              "type": [
                "number",
                "null"
              ]
            },
            "destinationZ": {
              "type": [
                "number",
                "null"
              ]
            },
            "ignoreGroundCheck": {
              "type": "boolean",
              "default": false
            },
            "moveMode": {
              "type": "string",
              "enum": [
                "Instant",
                "BySpeed",
                "ByDuration"
              ],
              "default": "BySpeed"
            },
            "moveSpeed": {
              "type": [
                "number",
                "null"
              ]
            },
            "moveDuration": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "npcIdentifier",
            "destinationType"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "destinationType": {
                    "const": "Position"
                  }
                }
              },
              "then": {
                "required": [
                  "destinationX",
                  "destinationY",
                  "destinationZ"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "destinationType": {
                    "const": "Waypoint"
                  }
                }
              },
              "then": {
                "required": [
                  "destinationIdentifier"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "moveMode": {
                    "const": "BySpeed"
                  }
                }
              },
              "then": {
                "required": [
                  "moveSpeed"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "moveMode": {
                    "const": "ByDuration"
                  }
                }
              },
              "then": {
                "required": [
                  "moveDuration"
                ]
              }
            }
          ]
        }
      ]
    },
    "ScenarioCameraTargetNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "CameraTarget"
            },
            "targetObjectIdentifier": {
              "type": "string"
            },
            "offsetX": {
              "type": "number",
              "default": 0
            },
            "offsetY": {
              "type": "number",
              "default": 0
            },
            "offsetZ": {
              "type": "number",
              "default": 0
            },
            "blendTime": {
              "type": "number",
              "minimum": 0,
              "default": 1
            }
          },
          "required": [
            "targetObjectIdentifier"
          ]
        }
      ]
    },
    "ScenarioInvokeEventNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "InvokeEvent"
            },
            "eventIdentifier": {
              "type": "string"
            },
            "moveNextBehavior": {
              "type": "string",
              "enum": [
                "False",
                "Immediately",
                "WaitUntilDone"
              ],
              "default": "WaitUntilDone"
            }
          },
          "required": [
            "eventIdentifier"
          ]
        }
      ]
    },
    "ScenarioValidatorNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "Validator"
            },
            "rootConditions": {
              "type": [
                "array",
                "null"
              ],
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/ScenarioValidatorRootCondition"
              }
            },
            "onFailure": {
              "type": "string",
              "enum": [
                "Panic",
                "Branching",
                "Ignore"
              ],
              "default": "Panic"
            },
            "failureReportTargets": {
              "type": "string",
              "default": "UnityConsole"
            },
            "failureNextIdentifier": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "rootConditions"
          ]
        }
      ]
    },
    "ScenarioValidatorRootCondition": {
      "type": "object",
      "properties": {
        "condition": {
          "type": "string",
          "enum": [
            "PlayerCountEqual",
            "PlayerCountNotEqual",
            "PlayerCountLessThan",
            "PlayerCountLessThanOrEqual",
            "PlayerCountGreaterThan",
            "PlayerCountGreaterThanOrEqual",
            "RegistryContains",
            "PlayerAssignedTag"
          ]
        },
        "targetCount": {
          "type": "integer"
        },
        "playerTag": {
          "type": [
            "string",
            "null"
          ]
        },
        "playerScope": {
          "type": "string",
          "enum": [
            "Any",
            "All",
            "Owner"
          ],
          "default": "Any"
        },
        "validationRules": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/ScenarioValidatorRule"
          }
        }
      },
      "required": [
        "condition"
      ],
      "additionalProperties": false
    },
    "ScenarioValidatorRule": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Registry"
          ],
          "default": "Registry"
        },
        "condition": {
          "type": "string",
          "enum": [
            "Contains"
          ],
          "default": "Contains"
        },
        "registryType": {
          "type": "string",
          "enum": [
            "Item",
            "ScenarioEvent",
            "ScenarioGraph",
            "IconSprite",
            "Npc",
            "Waypoint",
            "Entity",
            "Service",
            "RuntimeState",
            "InteractableEntity",
            "UI",
            "PlayerModel",
            "EntityPreset",
            "ProblemSet",
            "ProblemFigure",
            "PlayerTag"
          ],
          "default": "Waypoint"
        },
        "registryIdentifier": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "condition",
        "registryType",
        "registryIdentifier"
      ],
      "additionalProperties": false
    },
    "ScenarioParallelNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "Parallel"
            },
            "waitMode": {
              "type": "string",
              "enum": [
                "All",
                "Any",
                "None"
              ],
              "default": "All"
            },
            "allocationType": {
              "type": "string",
              "enum": [
                "SelfAll",
                "RandomOneAll",
                "SpreadRandom",
                "SpreadOrdinary"
              ],
              "default": "SelfAll"
            },
            "whenBranchingPlayerNotMatched": {
              "type": "string",
              "enum": [
                "Panic",
                "Ignore",
                "Reallocation"
              ],
              "default": "Panic"
            },
            "branches": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/ScenarioParallelBranch"
              }
            }
          },
          "required": [
            "branches"
          ]
        }
      ]
    },
    "ScenarioParallelBranch": {
      "type": "object",
      "properties": {
        "identifier": {
          "type": "string"
        },
        "completionConditionIdentifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "requiredPlayerTags": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbiddenPlayerTags": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredPlayerTagsMatchMode": {
          "type": "string",
          "enum": [
            "All",
            "Any"
          ],
          "default": "All"
        }
      },
      "required": [
        "identifier"
      ],
      "additionalProperties": false
    },
    "ScenarioDelayNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "Delay"
            },
            "durationSeconds": {
              "type": "number",
              "minimum": 0
            },
            "waitUntil": {
              "type": "string",
              "enum": [
                "Immediately",
                "WaitUntilDone"
              ],
              "default": "WaitUntilDone"
            }
          },
          "required": [
            "durationSeconds"
          ]
        }
      ]
    },
    "ScenarioInteractionNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "Interaction"
            },
            "actorScope": {
              "type": "string",
              "enum": [
                "Player",
                "Any"
              ],
              "default": "Player"
            },
            "targetIdentifier": {
              "type": "string"
            },
            "requiredItemIdentifier": {
              "type": [
                "string",
                "null"
              ]
            },
            "interactionType": {
              "type": "string",
              "enum": [
                "Use",
                "Inspect",
                "Attach",
                "Detach"
              ],
              "default": "Use"
            },
            "completionConditionIdentifier": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "actorScope",
            "targetIdentifier",
            "interactionType"
          ]
        }
      ]
    },
    "ScenarioCombineItemNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "CombineItem"
            },
            "inputItemIdentifiers": {
              "type": "array",
