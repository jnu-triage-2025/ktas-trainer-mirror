{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schema/multiplayer-scenario.schema.json",
  "title": "ScenarioGraph",
  "type": "object",
  "properties": {
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nodes": {
      "type": "object",
      "description": "Dictionary<string, IScenarioNode>",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/ScenarioNode"
      }
    }
  },
  "required": [
    "identifier",
    "nodes"
  ],
  "additionalProperties": false,
  "$defs": {
    "ScenarioNode": {
      "type": "object",
      "required": [
        "identifier",
        "nodeType"
      ],
      "oneOf": [
        {
          "$ref": "#/$defs/ScenarioDialogueNode"
        },
        {
          "$ref": "#/$defs/ScenarioChoiceNode"
        },
        {
          "$ref": "#/$defs/ScenarioSoundNode"
        },
        {
          "$ref": "#/$defs/ScenarioPlayerMoveNode"
        },
        {
          "$ref": "#/$defs/ScenarioNPCMoveNode"
        },
        {
          "$ref": "#/$defs/ScenarioCameraTargetNode"
        },
        {
          "$ref": "#/$defs/ScenarioInvokeEventNode"
        },
        {
          "$ref": "#/$defs/ScenarioValidatorNode"
        },
        {
          "$ref": "#/$defs/ScenarioParallelNode"
        },
        {
          "$ref": "#/$defs/ScenarioQuestControlNode"
        },
        {
          "$ref": "#/$defs/ScenarioQuestWaypointHighlightNode"
        },
        {
          "$ref": "#/$defs/ScenarioDelayNode"
        },
        {
          "$ref": "#/$defs/ScenarioInteractionNode"
        },
        {
          "$ref": "#/$defs/ScenarioCombineItemNode"
        },
        {
          "$ref": "#/$defs/ScenarioQuizNode"
        },
        {
          "$ref": "#/$defs/ScenarioStateUpdateNode"
        },
        {
          "$ref": "#/$defs/ScenarioPlayTTSNode"
        },
        {
          "$ref": "#/$defs/ScenarioPlayerTagNode"
        }
      ]
    },
    "ScenarioBaseNode": {
      "type": "object",
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "nextIdentifier": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "identifier"
      ],
      "additionalProperties": true
    },
    "ScenarioDialogueNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "Dialogue"
            },
            "speakerName": {
              "type": "string"
            },
            "dialogueContent": {
              "type": "string"
            },
            "portraitSpriteIdentifier": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "speakerName",
            "dialogueContent"
          ]
        }
      ]
    },
    "ScenarioChoiceNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "Choice"
            },
            "speakerName": {
              "type": "string"
            },
            "dialogueContent": {
              "type": "string"
            },
            "portraitSpriteIdentifier": {
              "type": [
                "string",
                "null"
              ]
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/ScenarioChoiceOption"
              }
            },
            "nextIdentifier": {
              "type": "null"
            }
          },
          "required": [
            "speakerName",
            "dialogueContent",
            "options"
          ]
        }
      ]
    },
    "ScenarioChoiceOption": {
      "type": "object",
      "properties": {
        "displayText": {
          "type": "string"
        },
        "displayIconIdentifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "displayColor": {
          "$ref": "#/$defs/ScenarioColor"
        },
        "nextNodeIdentifier": {
          "type": "string"
        }
      },
      "required": [
        "displayText",
        "nextNodeIdentifier"
      ],
      "additionalProperties": false
    },
    "ScenarioColor": {
      "type": "object",
      "properties": {
        "r": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "g": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "b": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "a": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "r",
        "g",
        "b",
        "a"
      ],
      "additionalProperties": false
    },
    "ScenarioSoundNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "Sound"
            },
            "soundResourceIdentifier": {
              "type": "string"
            },
            "waitUntilFinished": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "soundResourceIdentifier"
          ]
        }
      ]
    },
    "ScenarioPlayerMoveNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "PlayerMove"
            },
            "destinationType": {
              "type": "string",
              "enum": [
                "Position",
                "Waypoint"
              ]
            },
            "destinationIdentifier": {
              "type": [
                "string",
                "null"
              ]
            },
            "destinationX": {
              "type": [
                "number",
                "null"
              ]
            },
            "destinationY": {
              "type": [
                "number",
                "null"
              ]
            },
            "destinationZ": {
              "type": [
                "number",
                "null"
              ]
            },
            "ignoreGroundCheck": {
              "type": "boolean",
              "default": false
            },
            "moveMode": {
              "type": "string",
              "enum": [
                "Instant",
                "BySpeed",
                "ByDuration"
              ],
              "default": "BySpeed"
            },
            "moveSpeed": {
              "type": [
                "number",
                "null"
              ]
            },
            "moveDuration": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "destinationType"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "destinationType": {
                    "const": "Position"
                  }
                }
              },
              "then": {
                "required": [
                  "destinationX",
                  "destinationY",
                  "destinationZ"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "destinationType": {
                    "const": "Waypoint"
                  }
                }
              },
              "then": {
                "required": [
                  "destinationIdentifier"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "moveMode": {
                    "const": "BySpeed"
                  }
                }
              },
              "then": {
                "required": [
                  "moveSpeed"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "moveMode": {
                    "const": "ByDuration"
                  }
                }
              },
              "then": {
                "required": [
                  "moveDuration"
                ]
              }
            }
          ]
        }
      ]
    },
    "ScenarioNPCMoveNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "NPCMove"
            },
            "npcIdentifier": {
              "type": "string"
            },
            "destinationType": {
              "type": "string",
              "enum": [
                "Position",
                "Waypoint"
              ]
            },
            "destinationIdentifier": {
              "type": [
                "string",
                "null"
              ]
            },
            "destinationX": {
              "type": [
                "number",
                "null"
              ]
            },
            "destinationY": {
              "type": [
                "number",
                "null"
              ]
            },
            "destinationZ": {
              "type": [
                "number",
                "null"
              ]
            },
            "ignoreGroundCheck": {
              "type": "boolean",
              "default": false
            },
            "moveMode": {
              "type": "string",
              "enum": [
                "Instant",
                "BySpeed",
                "ByDuration"
              ],
              "default": "BySpeed"
            },
            "moveSpeed": {
              "type": [
                "number",
                "null"
              ]
            },
            "moveDuration": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "npcIdentifier",
            "destinationType"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "destinationType": {
                    "const": "Position"
                  }
                }
              },
              "then": {
                "required": [
                  "destinationX",
                  "destinationY",
                  "destinationZ"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "destinationType": {
                    "const": "Waypoint"
                  }
                }
              },
              "then": {
                "required": [
                  "destinationIdentifier"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "moveMode": {
                    "const": "BySpeed"
                  }
                }
              },
              "then": {
                "required": [
                  "moveSpeed"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "moveMode": {
                    "const": "ByDuration"
                  }
                }
              },
              "then": {
                "required": [
                  "moveDuration"
                ]
              }
            }
          ]
        }
      ]
    },
    "ScenarioCameraTargetNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "CameraTarget"
            },
            "targetObjectIdentifier": {
              "type": "string"
            },
            "offsetX": {
              "type": "number",
              "default": 0
            },
            "offsetY": {
              "type": "number",
              "default": 0
            },
            "offsetZ": {
              "type": "number",
              "default": 0
            },
            "blendTime": {
              "type": "number",
              "minimum": 0,
              "default": 1
            }
          },
          "required": [
            "targetObjectIdentifier"
          ]
        }
      ]
    },
    "ScenarioInvokeEventNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "InvokeEvent"
            },
            "eventIdentifier": {
              "type": "string"
            },
            "moveNextBehavior": {
              "type": "string",
              "enum": [
                "False",
                "Immediately",
                "WaitUntilDone"
              ],
              "default": "WaitUntilDone"
            }
          },
          "required": [
            "eventIdentifier"
          ]
        }
      ]
    },
    "ScenarioValidatorNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "Validator"
            },
            "condition": {
              "type": "string",
              "enum": [
                "PlayerCountEqual",
                "PlayerCountNotEqual",
                "PlayerCountLessThan",
                "PlayerCountLessThanOrEqual",
                "PlayerCountGreaterThan",
                "PlayerCountGreaterThanOrEqual"
              ]
            },
            "targetCount": {
              "type": "integer"
            },
            "onFailure": {
              "type": "string",
              "enum": [
                "Panic",
                "Branching",
                "Ignore"
              ],
              "default": "Panic"
            },
            "failureNextIdentifier": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "condition",
            "targetCount"
          ]
        }
      ]
    },
    "ScenarioParallelNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "Parallel"
            },
            "waitMode": {
              "type": "string",
              "enum": [
                "All",
                "Any",
                "None"
              ],
              "default": "All"
            },
            "allocationType": {
              "type": "string",
              "enum": [
                "SelfAll",
                "RandomOneAll",
                "SpreadRandom",
                "SpreadOrdinary"
              ],
              "default": "SelfAll"
            },
            "whenBranchingPlayerNotMatched": {
              "type": "string",
              "enum": [
                "Panic",
                "Ignore",
                "Reallocation"
              ],
              "default": "Panic"
            },
            "branches": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/ScenarioParallelBranch"
              }
            }
          },
          "required": [
            "branches"
          ]
        }
      ]
    },
    "ScenarioParallelBranch": {
      "type": "object",
      "properties": {
        "identifier": {
          "type": "string"
        },
        "completionConditionIdentifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "requiredPlayerTags": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbiddenPlayerTags": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredPlayerTagsMatchMode": {
          "type": "string",
          "enum": [
            "All",
            "Any"
          ],
          "default": "All"
        }
      },
      "required": [
        "identifier"
      ],
      "additionalProperties": false
    },
    "ScenarioDelayNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "Delay"
            },
            "durationSeconds": {
              "type": "number",
              "minimum": 0
            },
            "waitUntil": {
              "type": "string",
              "enum": [
                "Immediately",
                "WaitUntilDone"
              ],
              "default": "WaitUntilDone"
            }
          },
          "required": [
            "durationSeconds"
          ]
        }
      ]
    },
    "ScenarioInteractionNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "Interaction"
            },
            "actorScope": {
              "type": "string",
              "enum": [
                "Player",
                "Any"
              ],
              "default": "Player"
            },
            "targetIdentifier": {
              "type": "string"
            },
            "requiredItemIdentifier": {
              "type": [
                "string",
                "null"
              ]
            },
            "interactionType": {
              "type": "string",
              "enum": [
                "Use",
                "Inspect",
                "Attach",
                "Detach"
              ],
              "default": "Use"
            },
            "completionConditionIdentifier": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "actorScope",
            "targetIdentifier",
            "interactionType"
          ]
        }
      ]
    },
    "ScenarioCombineItemNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "CombineItem"
            },
            "inputItemIdentifiers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "outputItemIdentifier": {
              "type": "string"
            },
            "autoCombine": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "inputItemIdentifiers",
            "outputItemIdentifier"
          ]
        }
      ]
    },
    "ScenarioQuizNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "Quiz"
            },
            "question": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string"
              }
            },
            "correctIndex": {
              "type": "integer",
              "minimum": 0
            },
            "onCorrectNextIdentifier": {
              "type": "string"
            },
            "onIncorrectNextIdentifier": {
              "type": [
                "string",
                "null"
              ]
            },
            "feedbackCorrect": {
              "type": [
                "string",
                "null"
              ]
            },
            "feedbackIncorrect": {
              "type": [
                "string",
                "null"
              ]
            },
            "nextIdentifier": {
              "type": "null"
            }
          },
          "required": [
            "question",
            "options",
            "correctIndex",
            "onCorrectNextIdentifier"
          ]
        }
      ]
    },
    "ScenarioStateUpdateNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "StateUpdate"
            },
            "targetEntityIdentifier": {
              "type": "string"
            },
            "stateKey": {
              "type": "string"
            },
            "stateValue": {
              "type": "string"
            }
          },
          "required": [
            "targetEntityIdentifier",
            "stateKey",
            "stateValue"
          ]
        }
      ]
    },
    "ScenarioQuestControlNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "QuestControl"
            },
            "operation": {
              "type": "string",
              "enum": [
                "Add",
                "Update",
                "Remove"
              ]
            },
            "failureStrategy": {
              "type": "string",
              "enum": [
                "Overwrite",
                "Ignore",
                "Panic"
              ],
              "default": "Overwrite"
            },
            "quest": {
              "$ref": "#/$defs/ScenarioQuestData"
            }
          },
          "required": [
            "operation",
            "failureStrategy",
            "quest"
          ]
        }
      ]
    },
    "ScenarioQuestWaypointHighlightNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "QuestWaypointHighlight"
            },
            "waypointIdentifier": {
              "type": "string"
            }
          },
          "required": [
            "waypointIdentifier"
          ]
        }
      ]
    },
    "ScenarioQuestData": {
      "type": "object",
      "properties": {
        "Id": { "type": "string" },
        "Title": { "type": ["string", "null"] },
        "Description": { "type": ["string", "null"] },
        "QuestContent": { "type": ["string", "null"] },
        "waypointIdentifier": { "type": ["string", "null"] },
        "IsTracked": { "type": "boolean", "default": false }
      },
      "required": [ "Id" ],
      "additionalProperties": false
    },
    "ScenarioPlayTTSNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "const": "PlayTTS"
            },
            "transcriptIdentifier": {
              "type": "string",
              "minLength": 1
            },
            "variables": {
              "type": ["object", "null"],
              "additionalProperties": { "type": "string" }
            },
            "waitUntilFinished": {
              "type": "boolean",
              "default": true
            }
          },
          "required": [
            "transcriptIdentifier"
          ]
        }
      ]
    },
    "ScenarioPlayerTagNode": {
      "allOf": [
        {
          "$ref": "#/$defs/ScenarioBaseNode"
        },
        {
          "properties": {
            "nodeType": {
              "type": "string",
              "enum": [
                "PlayerTag",
                "TagModification"
              ]
            },
            "operation": {
              "type": "string",
              "enum": ["Add", "Remove", "Change"]
            },
            "scope": {
              "type": "string",
              "enum": ["All", "Current"],
              "default": "Current"
            },
            "tag": {
              "type": ["string", "null"]
            },
            "fromTag": {
              "type": ["string", "null"]
            },
            "toTag": {
              "type": ["string", "null"]
            }
          },
          "required": ["operation", "scope"],
          "allOf": [
            {
              "if": {
                "properties": { "operation": { "enum": ["Add", "Remove"] } }
              },
              "then": {
                "required": ["tag"]
              }
            },
            {
              "if": {
                "properties": { "operation": { "const": "Change" } }
              },
              "then": {
                "required": ["fromTag", "toTag"]
              }
            }
          ]
        }
      ]
    }
  }
}
