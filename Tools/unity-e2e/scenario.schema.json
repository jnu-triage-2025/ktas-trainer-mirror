{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unity-e2e.local/scenario.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "executionMode",
    "participants",
    "steps"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "executionMode": {
      "enum": [
        "regression",
        "exploration"
      ]
    },
    "participants": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "networkRole"
        ],
        "properties": {
          "networkRole": {
            "enum": [
              "host",
              "client",
              "dedicated",
              "editor"
            ]
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "cleanup": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "topology": {
      "enum": [
        "single",
        "host_plus_3_clients",
        "dedicated_plus_4_clients",
        "editor_host_plus_3_clients",
        "editor_plus_3_clients",
        "mixed_platform"
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graphId",
        "dataPacks"
      ],
      "properties": {
        "graphId": {
          "type": "string",
          "minLength": 1
        },
        "dataPacks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "type": {
          "enum": [
            "input",
            "uiAction",
            "wait",
            "assert",
            "assertEventually",
            "assertNever",
            "parallel",
            "barrier",
            "handoff",
            "checkpoint",
            "navigate",
            "dialogueAdvance",
            "dialogueChoose",
            "controlAcquire",
            "uiText",
            "interact"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "predicate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "args": {
          "type": "object"
        },
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "automationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "mode": {
          "enum": [
            "input_adapter",
            "device_input"
          ]
        },
        "owner": {
          "enum": [
            "Automation",
            "RemoteHuman"
          ]
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "branches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/step"
            }
          }
        },
        "sequence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation"
            ],
            "properties": {
              "operation": {
                "enum": [
                  "press",
                  "release",
                  "tap",
                  "hold",
                  "lookDelta",
                  "scroll",
                  "interactionSelect",
                  "interactionExecute",
                  "hotbarSelect",
                  "wait"
                ]
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "index": { "type": "integer", "minimum": 0, "maximum": 200 },
              "expectedEntityId": { "type": "string", "minLength": 1, "maxLength": 180 },
              "expectedInteractionId": { "type": "string", "minLength": 1, "maxLength": 180 },
              "durationMs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2000
              },
              "x": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "y": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              }
            },
            "allOf": [
              {
                "if": { "anyOf": [{ "required": ["expectedEntityId"] }, { "required": ["expectedInteractionId"] }] },
                "then": { "properties": { "operation": { "const": "interactionExecute" } } }
              },
              {
                "if": {
                  "properties": {
                    "operation": {
                      "enum": [
                        "press",
                        "release",
                        "tap",
                        "hold"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "key"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "operation": {
                      "const": "lookDelta"
                    }
                  }
                },
                "then": {
                  "required": [
                    "x",
                    "y"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "operation": {
                      "const": "scroll"
                    }
                  }
                },
                "then": {
                  "anyOf": [{ "required": ["x"] }, { "required": ["y"] }]
                }
              },
              {
                "if": { "properties": { "operation": { "enum": ["interactionSelect", "interactionExecute", "hotbarSelect"] } } },
                "then": { "required": ["index"] }
              },
              {
                "if": { "properties": { "operation": { "const": "hotbarSelect" } } },
                "then": { "properties": { "index": { "maximum": 9 } } }
              },
              {
                "if": {
                  "properties": {
                    "operation": {
                      "const": "wait"
                    }
                  }
                },
                "then": {
                  "required": [
                    "durationMs"
                  ]
                }
              }
            ]
          }
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "choiceId": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "maxLength": 1024
        },
        "action": {
          "enum": [
            "chat",
            "command",
            "inventory",
            "quest",
            "interact",
            "menu",
            "dialogueAdvance",
            "dialogueConfirm"
          ]
        }
      }
    }
  }
}
