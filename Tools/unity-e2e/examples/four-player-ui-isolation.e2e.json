{
  "version": "1.0",
  "id": "four_player_ui_isolation",
  "executionMode": "regression",
  "participants": {
    "p1": {
      "networkRole": "host"
    },
    "p2": {
      "networkRole": "client"
    },
    "p3": {
      "networkRole": "client"
    },
    "p4": {
      "networkRole": "client"
    }
  },
  "steps": [
    {
      "id": "ready",
      "type": "wait",
      "predicate": "participants.ready",
      "args": {
        "players": [
          "p1",
          "p2",
          "p3",
          "p4"
        ]
      },
      "timeoutMs": 30000
    },
    {
      "id": "inventory_control",
      "type": "controlAcquire",
      "actor": "p2"
    },
    {
      "id": "inventory_open",
      "type": "input",
      "actor": "p2",
      "action": "inventory"
    },
    {
      "id": "inventory_visible",
      "type": "wait",
      "predicate": "ui.visible",
      "args": {
        "actor": "p2",
        "automationId": "InventoryRoot"
      },
      "timeoutMs": 10000
    },
    {
      "id": "inventory_other_player_unchanged",
      "type": "assert",
      "predicate": "ui.visible",
      "args": {
        "actor": "p1",
        "automationId": "InventoryRoot",
        "visible": false
      }
    },
    {
      "id": "inventory_close",
      "type": "input",
      "actor": "p2",
      "action": "inventory"
    },
    {
      "id": "inventory_hidden",
      "type": "wait",
      "predicate": "ui.visible",
      "args": {
        "actor": "p2",
        "automationId": "InventoryRoot",
        "visible": false
      },
      "timeoutMs": 10000
    },
    {
      "id": "quest_control",
      "type": "controlAcquire",
      "actor": "p2"
    },
    {
      "id": "quest_open",
      "type": "input",
      "actor": "p2",
      "action": "quest"
    },
    {
      "id": "quest_visible",
      "type": "wait",
      "predicate": "ui.visible",
      "args": {
        "actor": "p2",
        "automationId": "quest-root"
      },
      "timeoutMs": 10000
    },
    {
      "id": "quest_other_player_unchanged",
      "type": "assert",
      "predicate": "ui.visible",
      "args": {
        "actor": "p1",
        "automationId": "quest-root",
        "visible": false
      }
    },
    {
      "id": "quest_close",
      "type": "input",
      "actor": "p2",
      "action": "quest"
    },
    {
      "id": "quest_hidden",
      "type": "wait",
      "predicate": "ui.visible",
      "args": {
        "actor": "p2",
        "automationId": "quest-root",
        "visible": false
      },
      "timeoutMs": 10000
    },
    {
      "id": "evidence",
      "type": "checkpoint"
    }
  ],
  "topology": "host_plus_3_clients"
}
